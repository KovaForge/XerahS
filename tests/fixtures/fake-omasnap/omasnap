#!/usr/bin/env bash
# Fake OmaSnap for XerahS tests (XIP0088). Implements the host-mode contract without a display.
#
# Environment:
#   FAKE_OMASNAP_MODE       ok | cancelled | error | garbage | timeout | nohost | stdout
#                           (default ok). "nohost" behaves like OmaSnap 1.21 (no host mode).
#   FAKE_OMASNAP_ARGV_FILE  append each argv, one argument per line, then a "--" separator.
#   FAKE_OMASNAP_PID_FILE   write this process id (lets tests check that cancel killed it).
#   FAKE_OMASNAP_CAPS       override the --host-capabilities JSON.
set -u

mode="${FAKE_OMASNAP_MODE:-ok}"

if [ -n "${FAKE_OMASNAP_ARGV_FILE:-}" ]; then
    for arg in "$@"; do printf '%s\n' "$arg" >> "$FAKE_OMASNAP_ARGV_FILE"; done
    printf -- '--\n' >> "$FAKE_OMASNAP_ARGV_FILE"
fi

if [ -n "${FAKE_OMASNAP_PID_FILE:-}" ]; then
    echo "$$" > "$FAKE_OMASNAP_PID_FILE"
fi

if [ "${1:-}" = "--host-capabilities" ]; then
    case "$mode" in
        nohost) echo "omasnap: unknown option --host-capabilities" >&2; exit 2 ;;
        garbage) echo "not json"; exit 0 ;;
        timeout) sleep 30; exit 0 ;;
    esac
    if [ -n "${FAKE_OMASNAP_CAPS:-}" ]; then
        printf '%s\n' "$FAKE_OMASNAP_CAPS"
    else
        printf '%s\n' '{"schemaVersion":1,"ok":true,"version":"1.22.0","hyprland":true,"extImageCopyCapture":true,"layerShell":true,"hostMode":1,"targets":["smart","region","windows","fullscreen","scroll"],"editor":["overlay","window"],"pin":true}'
    fi
    exit 0
fi

output=""
result=""
target="smart"
while [ $# -gt 0 ]; do
    case "$1" in
        --output) output="$2"; shift 2 ;;
        --result-json) result="$2"; shift 2 ;;
        --capture-region) target="region"; shift ;;
        --capture-window) target="windows"; shift ;;
        --capture-fullscreen) target="fullscreen"; shift ;;
        --scroll) target="scroll"; shift ;;
        --pin) sleep 0.1; exit 0 ;;
        *) shift ;;
    esac
done

emit() {
    if [ -z "$result" ] || [ "$result" = "-" ] || [ "$mode" = "stdout" ]; then
        printf '%s\n' "$1"
    else
        printf '%s\n' "$1" > "$result"
    fi
}

case "$mode" in
    cancelled)
        emit '{"schemaVersion":1,"status":"cancelled"}'
        exit 3
        ;;
    error)
        emit '{"schemaVersion":1,"status":"error","error":"capture failed: no focused output"}'
        exit 1
        ;;
    garbage)
        emit 'this is not json'
        exit 0
        ;;
    timeout)
        sleep 30
        exit 0
        ;;
esac

# 2x1 PNG (red, blue).
printf '%s' 'iVBORw0KGgoAAAANSUhEUgAAAAIAAAABCAIAAAB7QOjdAAAADUlEQVR4nGP4zwAE/wEHAAH/4iOeWQAAAABJRU5ErkJggg==' | base64 -d > "$output"
emit "{\"schemaVersion\":1,\"status\":\"ok\",\"target\":\"$target\",\"path\":\"$output\",\"pixelWidth\":2,\"pixelHeight\":1,\"logicalWidth\":2,\"logicalHeight\":1,\"scale\":1.0,\"monitor\":\"eDP-1\",\"region\":{\"x\":120,\"y\":80,\"width\":2,\"height\":1},\"window\":{\"class\":\"firefox\",\"title\":\"Example page\",\"address\":\"0x5559\"},\"annotated\":false,\"documentPath\":null,\"omasnapVersion\":\"1.22.0\"}"
exit 0
