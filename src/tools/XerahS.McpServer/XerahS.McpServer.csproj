<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <SelfContained>false</SelfContained>
    <PublishSingleFile>false</PublishSingleFile>
    <AssemblyName>xerahs-mcp</AssemblyName>
    <RootNamespace>XerahS.McpServer</RootNamespace>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../desktop/app/XerahS.Bootstrap/XerahS.Bootstrap.csproj" />
    <ProjectReference Include="../../desktop/core/XerahS.Core/XerahS.Core.csproj" />
    <ProjectReference Include="../../desktop/core/XerahS.History/XerahS.History.csproj" />
    <ProjectReference Include="../../desktop/core/XerahS.UploaderPluginSdk/XerahS.UploaderPluginSdk.csproj" />
  </ItemGroup>

</Project>
