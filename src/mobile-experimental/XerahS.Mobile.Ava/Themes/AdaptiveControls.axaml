<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Styles.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <Color x:Key="ThemeBackgroundColor">#FFF4F6FA</Color>
                    <Color x:Key="ThemeSurfaceColor">#FFFFFFFF</Color>
                    <Color x:Key="ThemeSurfaceVariantColor">#FFE9EDF3</Color>
                    <Color x:Key="ThemeForegroundColor">#FF111827</Color>
                    <Color x:Key="ThemeMutedForegroundColor">#FF6B7280</Color>
                    <Color x:Key="ThemeSuccessColor">#FF16A34A</Color>
                    <Color x:Key="ThemeSuccessBackgroundColor">#1A16A34A</Color>
                    <Color x:Key="ThemeWarningColor">#FFF59E0B</Color>
                    <Color x:Key="ThemeErrorColor">#FFEF4444</Color>
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <Color x:Key="ThemeBackgroundColor">#FF181B20</Color>
                    <Color x:Key="ThemeSurfaceColor">#FF23272F</Color>
                    <Color x:Key="ThemeSurfaceVariantColor">#FF2F343D</Color>
                    <Color x:Key="ThemeForegroundColor">#FFF4F7FA</Color>
                    <Color x:Key="ThemeMutedForegroundColor">#FF9CA3AF</Color>
                    <Color x:Key="ThemeSuccessColor">#FF22C55E</Color>
                    <Color x:Key="ThemeSuccessBackgroundColor">#1A22C55E</Color>
                    <Color x:Key="ThemeWarningColor">#FFF59E0B</Color>
                    <Color x:Key="ThemeErrorColor">#FFF87171</Color>
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

            <SolidColorBrush x:Key="ThemeBackgroundBrush" Color="{DynamicResource ThemeBackgroundColor}"/>
            <SolidColorBrush x:Key="ThemeSurfaceBrush" Color="{DynamicResource ThemeSurfaceColor}"/>
            <SolidColorBrush x:Key="ThemeSurfaceVariantBrush" Color="{DynamicResource ThemeSurfaceVariantColor}"/>
            <SolidColorBrush x:Key="ThemeForegroundBrush" Color="{DynamicResource ThemeForegroundColor}"/>
            <SolidColorBrush x:Key="ThemeMutedForegroundBrush" Color="{DynamicResource ThemeMutedForegroundColor}"/>
            <SolidColorBrush x:Key="ThemeAccentBrush" Color="{DynamicResource SystemAccentColor}"/>
            <SolidColorBrush x:Key="ThemeAccentForegroundBrush" Color="White"/>
            <SolidColorBrush x:Key="ThemeSuccessBrush" Color="{DynamicResource ThemeSuccessColor}"/>
            <SolidColorBrush x:Key="ThemeSuccessBackgroundBrush" Color="{DynamicResource ThemeSuccessBackgroundColor}"/>
            <SolidColorBrush x:Key="ThemeWarningBrush" Color="{DynamicResource ThemeWarningColor}"/>
            <SolidColorBrush x:Key="ThemeErrorBrush" Color="{DynamicResource ThemeErrorColor}"/>
        </ResourceDictionary>
    </Styles.Resources>

    <Style Selector="UserControl">
        <Setter Property="Background" Value="{DynamicResource ThemeBackgroundBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource ThemeForegroundBrush}"/>
    </Style>

    <Style Selector="Grid.adaptive-navbar">
        <Setter Property="Background" Value="{DynamicResource ThemeSurfaceBrush}"/>
        <Setter Property="Height" Value="56"/>
    </Style>

    <Style Selector="TextBlock.adaptive-navbar-title">
        <Setter Property="FontSize" Value="18"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    </Style>

    <Style Selector="TextBlock.adaptive-muted">
        <Setter Property="Foreground" Value="{DynamicResource ThemeMutedForegroundBrush}"/>
    </Style>

    <Style Selector="TextBlock.adaptive-accent">
        <Setter Property="Foreground" Value="{DynamicResource ThemeAccentBrush}"/>
    </Style>

    <Style Selector="TextBlock.adaptive-danger">
        <Setter Property="Foreground" Value="{DynamicResource ThemeErrorBrush}"/>
    </Style>

    <Style Selector="Button.adaptive-primary">
        <Setter Property="Background" Value="{DynamicResource ThemeAccentBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource ThemeAccentForegroundBrush}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="CornerRadius" Value="10"/>
        <Setter Property="Padding" Value="16,12"/>
        <Setter Property="MinHeight" Value="44"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>

    <Style Selector="Button.adaptive-secondary">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Foreground" Value="{DynamicResource ThemeAccentBrush}"/>
        <Setter Property="Padding" Value="12,8"/>
        <Setter Property="MinHeight" Value="44"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>

    <Style Selector="TextBox.adaptive-input">
        <Setter Property="Background" Value="{DynamicResource ThemeSurfaceVariantBrush}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="CornerRadius" Value="10"/>
        <Setter Property="Padding" Value="12,10"/>
        <Setter Property="MinHeight" Value="44"/>
    </Style>

    <Style Selector="ComboBox.adaptive-input">
        <Setter Property="MinHeight" Value="44"/>
    </Style>

    <Style Selector="Border.adaptive-card">
        <Setter Property="Background" Value="{DynamicResource ThemeSurfaceBrush}"/>
        <Setter Property="CornerRadius" Value="12"/>
        <Setter Property="Padding" Value="16"/>
        <Setter Property="Margin" Value="0,0,0,8"/>
    </Style>

    <Style Selector="ScrollViewer.adaptive-scroll">
        <Setter Property="ScrollViewer.IsScrollInertiaEnabled" Value="True"/>
    </Style>

</Styles>
