<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Styles.Resources>
        <ResourceDictionary>
            <FontFamily x:Key="iOSFont">San Francisco, -apple-system, BlinkMacSystemFont, Segoe UI</FontFamily>

            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <Color x:Key="ThemeBackgroundColor">#FFF2F2F7</Color>
                    <Color x:Key="ThemeSurfaceColor">#FFFFFFFF</Color>
                    <Color x:Key="ThemeSurfaceVariantColor">#FFE5E5EA</Color>
                    <Color x:Key="ThemeForegroundColor">#FF1C1C1E</Color>
                    <Color x:Key="ThemeMutedForegroundColor">#FF6B7280</Color>
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <Color x:Key="ThemeBackgroundColor">#FF1B1B1F</Color>
                    <Color x:Key="ThemeSurfaceColor">#FF2C2C2E</Color>
                    <Color x:Key="ThemeSurfaceVariantColor">#FF3A3A3C</Color>
                    <Color x:Key="ThemeForegroundColor">#FFF2F2F7</Color>
                    <Color x:Key="ThemeMutedForegroundColor">#FFAEAEB2</Color>
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

            <SolidColorBrush x:Key="ThemeBackgroundBrush" Color="{DynamicResource ThemeBackgroundColor}"/>
            <SolidColorBrush x:Key="ThemeSurfaceBrush" Color="{DynamicResource ThemeSurfaceColor}"/>
            <SolidColorBrush x:Key="ThemeSurfaceVariantBrush" Color="{DynamicResource ThemeSurfaceVariantColor}"/>
            <SolidColorBrush x:Key="ThemeForegroundBrush" Color="{DynamicResource ThemeForegroundColor}"/>
            <SolidColorBrush x:Key="ThemeMutedForegroundBrush" Color="{DynamicResource ThemeMutedForegroundColor}"/>
            <SolidColorBrush x:Key="ThemeAccentBrush" Color="{DynamicResource SystemAccentColor}"/>
            <SolidColorBrush x:Key="ThemeAccentForegroundBrush" Color="White"/>
        </ResourceDictionary>
    </Styles.Resources>

    <Style Selector="UserControl">
        <Setter Property="Background" Value="{DynamicResource ThemeBackgroundBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource ThemeForegroundBrush}"/>
    </Style>

    <Style Selector="UserControl TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource iOSFont}"/>
        <Setter Property="Foreground" Value="{DynamicResource ThemeForegroundBrush}"/>
    </Style>

    <Style Selector="UserControl Button">
        <Setter Property="FontFamily" Value="{StaticResource iOSFont}"/>
    </Style>

    <Style Selector="UserControl TextBox">
        <Setter Property="FontFamily" Value="{StaticResource iOSFont}"/>
        <Setter Property="Foreground" Value="{DynamicResource ThemeForegroundBrush}"/>
    </Style>

    <Style Selector="Button.cupertino-primary">
        <Setter Property="Background" Value="{DynamicResource ThemeAccentBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource ThemeAccentForegroundBrush}"/>
        <Setter Property="CornerRadius" Value="10"/>
        <Setter Property="Padding" Value="16,12"/>
        <Setter Property="FontFamily" Value="{StaticResource iOSFont}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="MinHeight" Value="44"/>
    </Style>

    <Style Selector="Button.cupertino-primary:pressed">
        <Setter Property="Opacity" Value="0.6"/>
    </Style>

    <Style Selector="Button.cupertino-secondary">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource ThemeAccentBrush}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="FontFamily" Value="{StaticResource iOSFont}"/>
        <Setter Property="Padding" Value="12,8"/>
        <Setter Property="MinHeight" Value="44"/>
    </Style>

    <Style Selector="Button.cupertino-secondary:pressed">
        <Setter Property="Opacity" Value="0.5"/>
    </Style>

    <Style Selector="TextBox.cupertino-input">
        <Setter Property="Background" Value="{DynamicResource ThemeSurfaceVariantBrush}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="CornerRadius" Value="10"/>
        <Setter Property="Padding" Value="12,10"/>
        <Setter Property="FontFamily" Value="{StaticResource iOSFont}"/>
        <Setter Property="MinHeight" Value="44"/>
    </Style>

    <Style Selector="Grid.cupertino-navbar">
        <Setter Property="Background" Value="{DynamicResource ThemeSurfaceBrush}"/>
        <Setter Property="Height" Value="56"/>
    </Style>

    <Style Selector="TextBlock.cupertino-navbar-title">
        <Setter Property="FontFamily" Value="{StaticResource iOSFont}"/>
        <Setter Property="FontSize" Value="17"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style Selector="Border.cupertino-card">
        <Setter Property="Background" Value="{DynamicResource ThemeSurfaceBrush}"/>
        <Setter Property="CornerRadius" Value="12"/>
        <Setter Property="Padding" Value="16"/>
        <Setter Property="Margin" Value="0,0,0,8"/>
    </Style>

    <Style Selector="Button.adaptive-primary">
        <Setter Property="Background" Value="{DynamicResource ThemeAccentBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource ThemeAccentForegroundBrush}"/>
        <Setter Property="CornerRadius" Value="10"/>
        <Setter Property="Padding" Value="16,12"/>
        <Setter Property="FontFamily" Value="{StaticResource iOSFont}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="MinHeight" Value="44"/>
    </Style>

    <Style Selector="Button.adaptive-primary:pressed">
        <Setter Property="Opacity" Value="0.6"/>
    </Style>

    <Style Selector="Button.adaptive-secondary">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource ThemeAccentBrush}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="12,8"/>
        <Setter Property="MinHeight" Value="44"/>
    </Style>

    <Style Selector="Button.adaptive-secondary:pressed">
        <Setter Property="Opacity" Value="0.5"/>
    </Style>

    <Style Selector="TextBox.adaptive-input">
        <Setter Property="Background" Value="{DynamicResource ThemeSurfaceVariantBrush}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="CornerRadius" Value="10"/>
        <Setter Property="Padding" Value="12,10"/>
        <Setter Property="MinHeight" Value="44"/>
    </Style>

    <Style Selector="ComboBox.adaptive-input">
        <Setter Property="MinHeight" Value="44"/>
        <Setter Property="CornerRadius" Value="10"/>
    </Style>

    <Style Selector="Grid.adaptive-navbar">
        <Setter Property="Background" Value="{DynamicResource ThemeSurfaceBrush}"/>
        <Setter Property="Height" Value="56"/>
    </Style>

    <Style Selector="TextBlock.adaptive-navbar-title">
        <Setter Property="FontSize" Value="17"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style Selector="Border.adaptive-card">
        <Setter Property="Background" Value="{DynamicResource ThemeSurfaceBrush}"/>
        <Setter Property="CornerRadius" Value="12"/>
        <Setter Property="Padding" Value="16"/>
        <Setter Property="Margin" Value="0,0,0,8"/>
    </Style>

    <Style Selector="ScrollViewer.adaptive-scroll">
        <Setter Property="ScrollViewer.IsScrollInertiaEnabled" Value="True"/>
    </Style>

</Styles>
