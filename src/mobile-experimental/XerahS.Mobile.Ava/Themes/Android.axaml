<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Styles.Resources>
        <ResourceDictionary>
            <FontFamily x:Key="MaterialFont">Roboto, Segoe UI</FontFamily>

            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <Color x:Key="ThemeBackgroundColor">#FFF6F7FB</Color>
                    <Color x:Key="ThemeSurfaceColor">#FFFFFFFF</Color>
                    <Color x:Key="ThemeSurfaceVariantColor">#FFEAEFF5</Color>
                    <Color x:Key="ThemeForegroundColor">#FF111827</Color>
                    <Color x:Key="ThemeMutedForegroundColor">#FF6B7280</Color>
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <Color x:Key="ThemeBackgroundColor">#FF171A1F</Color>
                    <Color x:Key="ThemeSurfaceColor">#FF23272F</Color>
                    <Color x:Key="ThemeSurfaceVariantColor">#FF303640</Color>
                    <Color x:Key="ThemeForegroundColor">#FFF4F7FA</Color>
                    <Color x:Key="ThemeMutedForegroundColor">#FF9CA3AF</Color>
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

            <SolidColorBrush x:Key="ThemeBackgroundBrush" Color="{DynamicResource ThemeBackgroundColor}"/>
            <SolidColorBrush x:Key="ThemeSurfaceBrush" Color="{DynamicResource ThemeSurfaceColor}"/>
            <SolidColorBrush x:Key="ThemeSurfaceVariantBrush" Color="{DynamicResource ThemeSurfaceVariantColor}"/>
            <SolidColorBrush x:Key="ThemeForegroundBrush" Color="{DynamicResource ThemeForegroundColor}"/>
            <SolidColorBrush x:Key="ThemeMutedForegroundBrush" Color="{DynamicResource ThemeMutedForegroundColor}"/>
            <SolidColorBrush x:Key="ThemeAccentBrush" Color="{DynamicResource SystemAccentColor}"/>
            <SolidColorBrush x:Key="ThemeAccentForegroundBrush" Color="White"/>
        </ResourceDictionary>
    </Styles.Resources>

    <Style Selector="UserControl">
        <Setter Property="Background" Value="{DynamicResource ThemeBackgroundBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource ThemeForegroundBrush}"/>
    </Style>

    <Style Selector="UserControl TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource MaterialFont}"/>
        <Setter Property="Foreground" Value="{DynamicResource ThemeForegroundBrush}"/>
    </Style>

    <Style Selector="UserControl Button">
        <Setter Property="FontFamily" Value="{StaticResource MaterialFont}"/>
    </Style>

    <Style Selector="UserControl TextBox">
        <Setter Property="FontFamily" Value="{StaticResource MaterialFont}"/>
        <Setter Property="Foreground" Value="{DynamicResource ThemeForegroundBrush}"/>
    </Style>

    <Style Selector="Button.material-primary">
        <Setter Property="Background" Value="{DynamicResource ThemeAccentBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource ThemeAccentForegroundBrush}"/>
        <Setter Property="CornerRadius" Value="24"/>
        <Setter Property="Padding" Value="24,12"/>
        <Setter Property="MinHeight" Value="48"/>
        <Setter Property="FontFamily" Value="{StaticResource MaterialFont}"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="BorderThickness" Value="0"/>
    </Style>

    <Style Selector="Button.material-primary:pressed">
        <Setter Property="Opacity" Value="0.9"/>
    </Style>

    <Style Selector="Button.material-outlined">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="{DynamicResource ThemeAccentBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Foreground" Value="{DynamicResource ThemeAccentBrush}"/>
        <Setter Property="CornerRadius" Value="24"/>
        <Setter Property="Padding" Value="24,12"/>
        <Setter Property="MinHeight" Value="48"/>
        <Setter Property="FontFamily" Value="{StaticResource MaterialFont}"/>
        <Setter Property="FontWeight" Value="Medium"/>
    </Style>

    <Style Selector="Button.material-outlined:pressed">
        <Setter Property="Opacity" Value="0.9"/>
    </Style>

    <Style Selector="TextBox.material-filled">
        <Setter Property="Background" Value="{DynamicResource ThemeSurfaceVariantBrush}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="CornerRadius" Value="12"/>
        <Setter Property="Padding" Value="14,14"/>
        <Setter Property="MinHeight" Value="56"/>
        <Setter Property="FontFamily" Value="{StaticResource MaterialFont}"/>
    </Style>

    <Style Selector="TextBox.material-outlined">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="{DynamicResource ThemeSurfaceVariantBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="12"/>
        <Setter Property="Padding" Value="14,14"/>
        <Setter Property="MinHeight" Value="56"/>
        <Setter Property="FontFamily" Value="{StaticResource MaterialFont}"/>
    </Style>

    <Style Selector="Grid.material-appbar">
        <Setter Property="Background" Value="{DynamicResource ThemeSurfaceBrush}"/>
        <Setter Property="Height" Value="56"/>
    </Style>

    <Style Selector="TextBlock.material-appbar-title">
        <Setter Property="FontFamily" Value="{StaticResource MaterialFont}"/>
        <Setter Property="FontSize" Value="20"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="HorizontalAlignment" Value="Left"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Margin" Value="56,0,0,0"/>
    </Style>

    <Style Selector="Border.material-card">
        <Setter Property="Background" Value="{DynamicResource ThemeSurfaceBrush}"/>
        <Setter Property="CornerRadius" Value="12"/>
        <Setter Property="Padding" Value="16"/>
        <Setter Property="Margin" Value="0,0,0,8"/>
        <Setter Property="BoxShadow" Value="0 2 4 0 #40000000"/>
    </Style>

    <Style Selector="Border.material-card-elevated">
        <Setter Property="Background" Value="{DynamicResource ThemeSurfaceBrush}"/>
        <Setter Property="CornerRadius" Value="12"/>
        <Setter Property="Padding" Value="16"/>
        <Setter Property="Margin" Value="0,0,0,8"/>
        <Setter Property="BoxShadow" Value="0 4 8 0 #40000000"/>
    </Style>

    <Style Selector="Button.adaptive-primary">
        <Setter Property="Background" Value="{DynamicResource ThemeAccentBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource ThemeAccentForegroundBrush}"/>
        <Setter Property="CornerRadius" Value="24"/>
        <Setter Property="Padding" Value="24,12"/>
        <Setter Property="MinHeight" Value="48"/>
        <Setter Property="FontFamily" Value="{StaticResource MaterialFont}"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="BorderThickness" Value="0"/>
    </Style>

    <Style Selector="Button.adaptive-primary:pressed">
        <Setter Property="Opacity" Value="0.9"/>
    </Style>

    <Style Selector="Button.adaptive-secondary">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="{DynamicResource ThemeAccentBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Foreground" Value="{DynamicResource ThemeAccentBrush}"/>
        <Setter Property="CornerRadius" Value="24"/>
        <Setter Property="Padding" Value="20,10"/>
        <Setter Property="MinHeight" Value="48"/>
        <Setter Property="FontFamily" Value="{StaticResource MaterialFont}"/>
        <Setter Property="FontWeight" Value="Medium"/>
    </Style>

    <Style Selector="Button.adaptive-secondary:pressed">
        <Setter Property="Opacity" Value="0.9"/>
    </Style>

    <Style Selector="TextBox.adaptive-input">
        <Setter Property="Background" Value="{DynamicResource ThemeSurfaceVariantBrush}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="CornerRadius" Value="12"/>
        <Setter Property="Padding" Value="14,14"/>
        <Setter Property="MinHeight" Value="56"/>
        <Setter Property="FontFamily" Value="{StaticResource MaterialFont}"/>
    </Style>

    <Style Selector="ComboBox.adaptive-input">
        <Setter Property="MinHeight" Value="56"/>
        <Setter Property="CornerRadius" Value="12"/>
        <Setter Property="FontFamily" Value="{StaticResource MaterialFont}"/>
    </Style>

    <Style Selector="Grid.adaptive-navbar">
        <Setter Property="Background" Value="{DynamicResource ThemeSurfaceBrush}"/>
        <Setter Property="Height" Value="56"/>
    </Style>

    <Style Selector="TextBlock.adaptive-navbar-title">
        <Setter Property="FontFamily" Value="{StaticResource MaterialFont}"/>
        <Setter Property="FontSize" Value="20"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="HorizontalAlignment" Value="Left"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Margin" Value="16,0,0,0"/>
    </Style>

    <Style Selector="Border.adaptive-card">
        <Setter Property="Background" Value="{DynamicResource ThemeSurfaceBrush}"/>
        <Setter Property="CornerRadius" Value="12"/>
        <Setter Property="Padding" Value="16"/>
        <Setter Property="Margin" Value="0,0,0,8"/>
        <Setter Property="BoxShadow" Value="0 2 4 0 #40000000"/>
    </Style>

    <Style Selector="ScrollViewer.adaptive-scroll">
        <Setter Property="ScrollViewer.IsScrollInertiaEnabled" Value="True"/>
    </Style>

</Styles>
