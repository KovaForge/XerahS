<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="using:XerahS.UI.Views">
  <Styles.Resources>
    <SolidColorBrush x:Key="SolidBackgroundFillColorBaseBrush"
                     Color="{DynamicResource ShareX.Color.Background.Main}" />
    <SolidColorBrush x:Key="SolidBackgroundFillColorSecondaryBrush"
                     Color="{DynamicResource ShareX.Color.Background.Panel}" />
    <SolidColorBrush x:Key="CardBackgroundFillColorDefaultBrush"
                     Color="{DynamicResource ShareX.Color.Background.Panel}" />
    <SolidColorBrush x:Key="CardBackgroundFillColorSecondaryBrush"
                     Color="{DynamicResource ShareX.Color.Background.Main}" />
    <SolidColorBrush x:Key="LayerFillColorDefaultBrush"
                     Color="{DynamicResource ShareX.Color.Background.Panel}" />
    <SolidColorBrush x:Key="ControlFillColorDefaultBrush"
                     Color="{DynamicResource ShareX.Color.Background.Panel}" />
    <SolidColorBrush x:Key="ControlFillColorSecondaryBrush"
                     Color="{DynamicResource ShareX.Color.Background.Main}" />
    <SolidColorBrush x:Key="ControlAltFillColorDefaultBrush"
                     Color="{DynamicResource ShareX.Color.Background.Panel}" />
    <SolidColorBrush x:Key="SystemControlBackgroundChromeMediumBrush"
                     Color="{DynamicResource ShareX.Color.Background.Panel}" />
    <SolidColorBrush x:Key="SystemControlBackgroundAltHighBrush"
                     Color="{DynamicResource ShareX.Color.Background.Panel}" />
    <SolidColorBrush x:Key="SystemControlBackgroundAltMediumBrush"
                     Color="{DynamicResource ShareX.Color.Background.Panel}" />
    <SolidColorBrush x:Key="SystemControlBackgroundBaseLowBrush"
                     Color="{DynamicResource ShareX.Color.Background.Panel}" />
    <SolidColorBrush x:Key="SystemControlBackgroundBaseMediumBrush"
                     Color="{DynamicResource ShareX.Color.Background.Panel}" />
    <SolidColorBrush x:Key="TextFillColorPrimaryBrush"
                     Color="{DynamicResource ShareX.Color.Text}" />
    <SolidColorBrush x:Key="TextFillColorSecondaryBrush"
                     Color="{DynamicResource ShareX.Color.Text.Secondary}" />
    <SolidColorBrush x:Key="TextFillColorTertiaryBrush"
                     Color="{DynamicResource ShareX.Color.Text.Secondary}" />
    <SolidColorBrush x:Key="TextFillColorDisabledBrush"
                     Color="{DynamicResource ShareX.Color.Text.Secondary}"
                     Opacity="0.6" />
    <SolidColorBrush x:Key="SystemControlForegroundBaseMediumBrush"
                     Color="{DynamicResource ShareX.Color.Text.Secondary}" />
    <SolidColorBrush x:Key="SystemControlForegroundBaseHighBrush"
                     Color="{DynamicResource ShareX.Color.Text}" />
    <SolidColorBrush x:Key="SystemControlForegroundBaseLowBrush"
                     Color="{DynamicResource ShareX.Color.Border}" />
    <SolidColorBrush x:Key="SystemControlForegroundBaseMediumLowBrush"
                     Color="{DynamicResource ShareX.Color.Border}" />
    <SolidColorBrush x:Key="SystemControlForegroundListLowBrush"
                     Color="{DynamicResource ShareX.Color.Border}" />
    <SolidColorBrush x:Key="SystemControlHighlightListAccentLowBrush"
                     Color="{DynamicResource ShareX.Color.Accent.End}"
                     Opacity="0.7" />
    <SolidColorBrush x:Key="TextControlBackground"
                     Color="{DynamicResource ShareX.Color.Background.Panel}" />
    <SolidColorBrush x:Key="TextControlBackgroundDisabled"
                     Color="{DynamicResource ShareX.Color.Background.Main}" />
    <SolidColorBrush x:Key="TextControlBackgroundFocused"
                     Color="{DynamicResource ShareX.Color.Background.Panel}" />
    <SolidColorBrush x:Key="TextControlBackgroundPointerOver"
                     Color="{DynamicResource ShareX.Color.Background.Panel}" />
    <SolidColorBrush x:Key="TextControlBackgroundReadOnly"
                     Color="{DynamicResource ShareX.Color.Background.Panel}" />
    <SolidColorBrush x:Key="TextControlForeground"
                     Color="{DynamicResource ShareX.Color.Text}" />
    <SolidColorBrush x:Key="TextControlForegroundFocused"
                     Color="{DynamicResource ShareX.Color.Text}" />
    <SolidColorBrush x:Key="TextControlForegroundDisabled"
                     Color="{DynamicResource ShareX.Color.Text.Secondary}"
                     Opacity="0.75" />
    <SolidColorBrush x:Key="TextControlForegroundPointerOver"
                     Color="{DynamicResource ShareX.Color.Text}" />
    <SolidColorBrush x:Key="TextControlForegroundReadOnly"
                     Color="{DynamicResource ShareX.Color.Text}" />
    <SolidColorBrush x:Key="TextControlBorderBrush"
                     Color="{DynamicResource ShareX.Color.Border}" />
    <SolidColorBrush x:Key="TextControlBorderBrushDisabled"
                     Color="{DynamicResource ShareX.Color.Border}" />
    <SolidColorBrush x:Key="TextControlBorderBrushFocused"
                     Color="{DynamicResource ShareX.Color.Accent.End}" />
    <SolidColorBrush x:Key="TextControlBorderBrushPointerOver"
                     Color="{DynamicResource ShareX.Color.Border}" />
    <SolidColorBrush x:Key="TextControlBorderBrushReadOnly"
                     Color="{DynamicResource ShareX.Color.Border}" />
    <SolidColorBrush x:Key="ColorViewContentBackgroundBrush"
                     Color="{DynamicResource ShareX.Color.Background.Panel}" />
    <SolidColorBrush x:Key="ColorViewContentBorderBrush"
                     Color="{DynamicResource ShareX.Color.Border}" />
    <SolidColorBrush x:Key="ColorViewTabBorderBrush"
                     Color="{DynamicResource ShareX.Color.Border}" />
    <SolidColorBrush x:Key="SurfaceStrokeColorDefaultBrush"
                     Color="{DynamicResource ShareX.Color.Border}" />
    <SolidColorBrush x:Key="SystemBaseMediumColor"
                     Color="{DynamicResource ShareX.Color.Text.Secondary}" />
    <SolidColorBrush x:Key="SystemBaseLowColor"
                     Color="{DynamicResource ShareX.Color.Border}" />

    <LinearGradientBrush x:Key="AccentFillColorDefaultBrush"
                         StartPoint="0%,0%"
                         EndPoint="100%,100%">
      <GradientStop Color="{DynamicResource ShareX.Color.Accent.Start}" Offset="0" />
      <GradientStop Color="{DynamicResource ShareX.Color.Accent.End}" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="AccentButtonPointerOverBrush"
                         StartPoint="0%,0%"
                         EndPoint="100%,100%"
                         Opacity="0.92">
      <GradientStop Color="{DynamicResource ShareX.Color.Accent.Start}" Offset="0" />
      <GradientStop Color="{DynamicResource ShareX.Color.Accent.End}" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="AccentButtonPressedBrush"
                         StartPoint="0%,0%"
                         EndPoint="100%,100%"
                         Opacity="0.82">
      <GradientStop Color="{DynamicResource ShareX.Color.Accent.Start}" Offset="0" />
      <GradientStop Color="{DynamicResource ShareX.Color.Accent.End}" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="AccentButtonDisabledBrush"
                         StartPoint="0%,0%"
                         EndPoint="100%,100%"
                         Opacity="0.55">
      <GradientStop Color="{DynamicResource ShareX.Color.Accent.Start}" Offset="0" />
      <GradientStop Color="{DynamicResource ShareX.Color.Accent.End}" Offset="1" />
    </LinearGradientBrush>

    <SolidColorBrush x:Key="AccentButtonForegroundBrush"
                     Color="White" />

    <SolidColorBrush x:Key="AccentButtonForegroundDisabledBrush"
                     Color="White"
                     Opacity="0.78" />
    <SolidColorBrush x:Key="StatusSuccessFillBrush"
                     Color="{DynamicResource ShareX.Color.Status.Success.Background}" />
    <SolidColorBrush x:Key="StatusSuccessBorderBrush"
                     Color="{DynamicResource ShareX.Color.Status.Success.Border}" />
    <SolidColorBrush x:Key="StatusSuccessForegroundBrush"
                     Color="{DynamicResource ShareX.Color.Status.Success.Foreground}" />
    <SolidColorBrush x:Key="StatusWarningFillBrush"
                     Color="{DynamicResource ShareX.Color.Status.Warning.Background}" />
    <SolidColorBrush x:Key="StatusWarningBorderBrush"
                     Color="{DynamicResource ShareX.Color.Status.Warning.Border}" />
    <SolidColorBrush x:Key="StatusWarningForegroundBrush"
                     Color="{DynamicResource ShareX.Color.Status.Warning.Foreground}" />
    <SolidColorBrush x:Key="StatusErrorFillBrush"
                     Color="{DynamicResource ShareX.Color.Status.Error.Background}" />
    <SolidColorBrush x:Key="StatusErrorBorderBrush"
                     Color="{DynamicResource ShareX.Color.Status.Error.Border}" />
    <SolidColorBrush x:Key="StatusErrorForegroundBrush"
                     Color="{DynamicResource ShareX.Color.Status.Error.Foreground}" />

    <ControlTheme x:Key="CardBorderTheme" TargetType="Border">
      <Setter Property="Background" Value="{DynamicResource SolidBackgroundFillColorSecondaryBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource SurfaceStrokeColorDefaultBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="8" />
    </ControlTheme>
  </Styles.Resources>

  <Style Selector="TextBlock.IconGlyph">
    <Setter Property="FontFamily" Value="{DynamicResource ShareX.FontFamily.Icon}" />
    <Setter Property="FontWeight" Value="Normal" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <Style Selector="TextBlock.section-header">
    <Setter Property="FontSize" Value="16" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>

  <Style Selector="TextBlock.section-title">
    <Setter Property="FontSize" Value="14" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>

  <Style Selector="TextBlock.caption">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
  </Style>

  <Style Selector="TextBlock.on-accent">
    <Setter Property="Foreground" Value="{DynamicResource AccentButtonForegroundBrush}" />
  </Style>

  <Style Selector="TextBlock.status-success">
    <Setter Property="Foreground" Value="{DynamicResource StatusSuccessForegroundBrush}" />
  </Style>

  <Style Selector="TextBlock.status-warning">
    <Setter Property="Foreground" Value="{DynamicResource StatusWarningForegroundBrush}" />
  </Style>

  <Style Selector="TextBlock.status-error">
    <Setter Property="Foreground" Value="{DynamicResource StatusErrorForegroundBrush}" />
  </Style>

  <Style Selector=":is(views|PageView)">
    <Setter Property="Background" Value="{DynamicResource SolidBackgroundFillColorSecondaryBrush}" />
  </Style>

  <Style Selector=":is(views|SurfaceWindow)">
    <Setter Property="Background" Value="{DynamicResource SolidBackgroundFillColorSecondaryBrush}" />
  </Style>

  <!-- Accent is the default button treatment app-wide. Buttons that intentionally
       need a different presentation must opt out semantically instead of relying
       on the stock Fluent default. -->
  <Style Selector="Button:not(.SettingsRow):not(.ColorSwatchButton):not(.DarkButton):not(.NoAccent)">
    <Setter Property="Background" Value="{DynamicResource AccentFillColorDefaultBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource AccentButtonForegroundBrush}" />
  </Style>

  <Style Selector="Button:pointerover:not(.SettingsRow):not(.ColorSwatchButton):not(.DarkButton):not(.NoAccent)">
    <Setter Property="Background" Value="{DynamicResource AccentButtonPointerOverBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AccentButtonPointerOverBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource AccentButtonForegroundBrush}" />
  </Style>

  <Style Selector="Button:pressed:not(.SettingsRow):not(.ColorSwatchButton):not(.DarkButton):not(.NoAccent)">
    <Setter Property="Background" Value="{DynamicResource AccentButtonPressedBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AccentButtonPressedBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource AccentButtonForegroundBrush}" />
  </Style>

  <Style Selector="Button:disabled:not(.SettingsRow):not(.ColorSwatchButton):not(.DarkButton):not(.NoAccent)">
    <Setter Property="Background" Value="{DynamicResource AccentButtonDisabledBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AccentButtonDisabledBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource AccentButtonForegroundDisabledBrush}" />
    <Setter Property="Opacity" Value="1" />
  </Style>

  <Style Selector="Button.DarkButton">
    <Setter Property="Background" Value="#25263A" />
    <Setter Property="Foreground" Value="#E2E8F0" />
    <Setter Property="BorderBrush" Value="#3B3B52" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="8" />
  </Style>

  <Style Selector="Button.DarkButton.active">
    <Setter Property="Background" Value="#8B5CF6" />
    <Setter Property="Foreground" Value="White" />
    <Setter Property="BorderBrush" Value="#8B5CF6" />
  </Style>

  <Style Selector="Button.ColorSwatchButton">
    <Setter Property="ToolTip.Placement" Value="Top" />
  </Style>

  <!-- Standard surface-owning controls should resolve to the app's shared panel/card
       palette instead of stock Fluent dark fills. Local values in individual XAML
       files still win when a specific screen needs a different surface. -->
  <Style Selector="Border.card">
    <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>

  <Style Selector="Border.section-card">
    <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource SystemBaseLowColor}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="Padding" Value="12" />
  </Style>

  <Style Selector="Border.accent-chip">
    <Setter Property="Background" Value="{DynamicResource AccentFillColorDefaultBrush}" />
    <Setter Property="CornerRadius" Value="3" />
    <Setter Property="Padding" Value="6,2" />
  </Style>

  <Style Selector="Border.hotkeySurface">
    <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
  </Style>

  <Style Selector="Border.hotkeySurface.highlighted">
    <Setter Property="BorderBrush" Value="{DynamicResource SystemAccentColor}" />
    <Setter Property="BorderThickness" Value="2" />
  </Style>

  <Style Selector="Border.hotkeyCaptureSurface">
    <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>

  <Style Selector="Border.status-success">
    <Setter Property="Background" Value="{DynamicResource StatusSuccessFillBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource StatusSuccessBorderBrush}" />
  </Style>

  <Style Selector="Border.status-warning">
    <Setter Property="Background" Value="{DynamicResource StatusWarningFillBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource StatusWarningBorderBrush}" />
  </Style>

  <Style Selector="Border.status-error">
    <Setter Property="Background" Value="{DynamicResource StatusErrorFillBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource StatusErrorBorderBrush}" />
  </Style>

  <Style Selector="Window ScrollViewer">
    <Setter Property="AllowAutoHide" Value="False" />
    <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
  </Style>

  <Style Selector="Window ListBox">
    <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
  </Style>

  <Style Selector="Window TabControl">
    <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
  </Style>

  <Style Selector="Window TreeView">
    <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
  </Style>

  <Style Selector="Window DataGrid">
    <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
  </Style>

  <Style Selector=":is(views|SurfaceWindow) ListBoxItem">
    <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
  </Style>

  <Style Selector=":is(views|SurfaceWindow) ListBoxItem:selected">
    <Setter Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
  </Style>

  <Style Selector=":is(views|SurfaceWindow) DataGridColumnHeader">
    <Setter Property="Background" Value="{DynamicResource LayerFillColorDefaultBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
  </Style>

  <Style Selector=":is(views|SurfaceWindow) DataGridRow">
    <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
  </Style>

  <Style Selector=":is(views|SurfaceWindow) DataGridCell">
    <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
  </Style>

  <Style Selector="Window TextBox">
    <Setter Property="Background" Value="{DynamicResource ControlFillColorDefaultBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
  </Style>

  <Style Selector="TextBox.readonly">
    <Setter Property="IsReadOnly" Value="True" />
    <Setter Property="Background" Value="{DynamicResource ControlFillColorDefaultBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="6" />
  </Style>

  <Style Selector="TextBox.status-success">
    <Setter Property="Background" Value="{DynamicResource StatusSuccessFillBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource StatusSuccessForegroundBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource StatusSuccessBorderBrush}" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>

  <Style Selector="TextBox.status-warning">
    <Setter Property="Background" Value="{DynamicResource StatusWarningFillBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource StatusWarningForegroundBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource StatusWarningBorderBrush}" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>

  <Style Selector="TextBox.status-error">
    <Setter Property="Background" Value="{DynamicResource StatusErrorFillBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource StatusErrorForegroundBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource StatusErrorBorderBrush}" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>

  <Style Selector="Window ComboBox">
    <Setter Property="Background" Value="{DynamicResource ControlFillColorDefaultBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
  </Style>

  <Style Selector="Window NumericUpDown">
    <Setter Property="Background" Value="{DynamicResource ControlFillColorDefaultBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
  </Style>

  <Style Selector="Window AutoCompleteBox">
    <Setter Property="Background" Value="{DynamicResource ControlFillColorDefaultBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
  </Style>

  <Style Selector="Separator.ToolbarSeparator">
    <Setter Property="Width" Value="1" />
    <Setter Property="MinHeight" Value="24" />
    <Setter Property="Margin" Value="4,0" />
    <Setter Property="Background" Value="{DynamicResource SurfaceStrokeColorDefaultBrush}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <Style Selector="Button.SettingsRow">
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="Padding" Value="14,12" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="8" />
  </Style>

  <Style Selector="Button.SettingsRow:pointerover">
    <Setter Property="Background" Value="{DynamicResource SolidBackgroundFillColorSecondaryBrush}" />
  </Style>

  <Style Selector="Button.SettingsRow:pressed">
    <Setter Property="Background" Value="{DynamicResource SolidBackgroundFillColorBaseBrush}" />
  </Style>
</Styles>
