<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:XerahS.UI.Onboarding"
        xmlns:steps="using:XerahS.UI.Onboarding.ViewModels.Steps"
        xmlns:conv="using:XerahS.UI.Onboarding"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="640" d:DesignHeight="520"
        x:Class="XerahS.UI.Onboarding.OnboardingWizardWindow"
        x:DataType="vm:OnboardingWizardViewModel"
        Title="Welcome to XerahS"
        Width="640"
        Height="520"
        MinWidth="480"
        MinHeight="440"
        MaxWidth="800"
        MaxHeight="640"
        WindowStartupLocation="CenterScreen"
        SizeToContent="Manual"
        SystemDecorations="Full"
        CanResize="True"
        Background="{DynamicResource SolidBackgroundFillColorBaseBrush}">

  <Window.Resources>
    <conv:EqualsConverter x:Key="EqualsConverter" />
    <conv:StepIndexToBrushConverter x:Key="StepIndexToBrushConverter" />
    <conv:LessThanConverter x:Key="LessThanConverter" />
    <conv:SubtractOneConverter x:Key="SubtractOneConverter" />
    <conv:StringNotEmptyConverter x:Key="StringNotEmptyConverter" />
    <conv:StringEqualsConverter x:Key="StringEqualsConverter" />
    <conv:ListContainsConverter x:Key="ListContainsConverter" />
    <conv:InverseBoolConverter x:Key="InverseBoolConverter" />
    <conv:BoolToSuccessErrorBrushConverter x:Key="BoolToSuccessErrorBrushConverter" />
    <conv:BoolToStringConverter x:Key="BoolToStringConverter" />
  </Window.Resources>

  <Window.Styles>
    <StyleInclude Source="/Onboarding/Styles/OnboardingStyles.axaml" />
  </Window.Styles>

  <Design.DataContext>
    <vm:OnboardingWizardViewModel/>
  </Design.DataContext>

  <Grid RowDefinitions="Auto,Auto,*,Auto,Auto" Margin="24">

    <!-- Close Button (top-right) -->
    <Button Grid.Row="0"
            HorizontalAlignment="Right"
            VerticalAlignment="Top"
            Command="{Binding SkipAllCommand}"
            Classes="WizardGhostButton"
            ToolTip.Tip="Skip wizard"
            Padding="8,4"
            Width="36" Height="36">
      <TextBlock Text="X" FontWeight="Bold" FontSize="14" />
    </Button>

    <!-- Step Indicator -->
    <StackPanel Grid.Row="1"
                Orientation="Horizontal"
                HorizontalAlignment="Center"
                Margin="0,0,0,16"
                Spacing="0">
      <ItemsControl ItemsSource="{Binding Steps}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <StackPanel Orientation="Horizontal" Spacing="0"/>
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate DataType="vm:StepViewModelBase">
            <StackPanel Orientation="Horizontal" Spacing="0">
              <!-- Step dot -->
              <Grid Width="32" Height="32" VerticalAlignment="Center">
                <Ellipse Width="16" Height="16"
                         HorizontalAlignment="Center" VerticalAlignment="Center"
                         Fill="{DynamicResource AccentFillColorDefaultBrush}"
                         IsVisible="{Binding StepIndex, Converter={StaticResource LessThanConverter}, ConverterParameter={Binding $parent[ItemsControl].((vm:OnboardingWizardViewModel)DataContext).CurrentStepIndex}}" />
                <Ellipse Width="16" Height="16"
                         HorizontalAlignment="Center" VerticalAlignment="Center"
                         Stroke="{DynamicResource AccentFillColorDefaultBrush}"
                         StrokeThickness="2"
                         Fill="Transparent"
                         IsVisible="{Binding StepIndex, Converter={StaticResource LessThanConverter}, ConverterParameter={Binding $parent[ItemsControl].((vm:OnboardingWizardViewModel)DataContext).CurrentStepIndex}, ConverterParameter={StaticResource InverseBoolConverter}}" />
                <TextBlock Text="{Binding StepIndex}"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           FontSize="11" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           IsVisible="{Binding StepIndex, Converter={StaticResource LessThanConverter}, ConverterParameter={Binding $parent[ItemsControl].((vm:OnboardingWizardViewModel)DataContext).CurrentStepIndex}, ConverterParameter={StaticResource InverseBoolConverter}}" />
              </Grid>
              <!-- Connecting line -->
              <Rectangle Width="24" Height="2"
                         VerticalAlignment="Center"
                         Fill="{DynamicResource ControlStrokeColorDefaultBrush}"
                         Margin="4,0,4,0"
                         IsVisible="{Binding StepIndex, Converter={StaticResource LessThanConverter}, ConverterParameter={Binding $parent[ItemsControl].((vm:OnboardingWizardViewModel)DataContext).CurrentStepIndex}}" />
            </StackPanel>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>

    <!-- Content Area -->
    <Border Grid.Row="2"
            Classes="section-card"
            Padding="24"
            Margin="0,0,0,16">
      <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="16">
          <!-- Step Header -->
          <StackPanel Spacing="4">
            <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
              <!-- Step icon using Lucide -->
              <Border Width="40" Height="40"
                      Background="{DynamicResource AccentFillColorSecondaryBrush}"
                      CornerRadius="20"
                      HorizontalAlignment="Left">
                <TextBlock Text="X"
                           FontFamily="avares://ShareX.ImageEditor/Assets#lucide"
                           FontSize="18"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Foreground="{DynamicResource AccentFillColorDefaultBrush}"
                           IsVisible="{Binding CurrentStepIndex, Converter={x:Static conv:EqualsConverter.Instance}, ConverterParameter=0}"/>
                <!-- Note: Full icon rendering via code-behind for Lucide glyphs -->
              </Border>
              <TextBlock Text="{Binding CurrentStep.StepTitle}"
                         Classes="section-header"
                         VerticalAlignment="Center"/>
            </StackPanel>
            <TextBlock Text="{Binding CurrentStep.StepSubtitle}"
                       FontSize="14"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
            <TextBlock Text="{Binding CurrentStep.StepDescription}"
                       FontSize="12"
                       Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                       TextWrapping="Wrap"
                       Margin="0,4,0,0"/>
          </StackPanel>

          <!-- Validation Error -->
          <Border Classes="status-error"
                  Padding="12"
                  IsVisible="{Binding CurrentStep.ValidationError, Converter={StaticResource StringNotEmptyConverter}}">
            <TextBlock Text="{Binding CurrentStep.ValidationError}"
                       Foreground="{DynamicResource StatusErrorForegroundBrush}"
                       TextWrapping="Wrap"/>
          </Border>

          <!-- Step Content -->
          <ContentControl Content="{Binding CurrentStep}">
            <ContentControl.DataTemplates>
              <!-- Welcome Step -->
              <DataTemplate DataType="steps:WelcomeStepViewModel">
                <StackPanel Spacing="16">
                  <StackPanel Spacing="6">
                    <TextBlock Text="Display Language"
                               Classes="WizardSectionHeader"
                               Margin="0"/>
                    <ComboBox ItemsSource="{Binding AvailableLanguages}"
                              SelectedValue="{Binding SelectedLanguage}"
                              SelectedValueBinding="{Binding Code}"
                              Width="300"
                              HorizontalAlignment="Left"
                              Classes="WizardComboBox">
                      <ComboBox.ItemTemplate>
                        <DataTemplate>
                          <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="{Binding DisplayName}"/>
                            <TextBlock Text="-" Opacity="0.5"/>
                            <TextBlock Text="{Binding NativeName}" Opacity="0.7"/>
                          </StackPanel>
                        </DataTemplate>
                      </ComboBox.ItemTemplate>
                    </ComboBox>
                  </StackPanel>
                  <TextBlock Text="{Binding FallbackHint}"
                             IsVisible="{Binding FallbackHint, Converter={StaticResource StringNotEmptyConverter}}"
                             Foreground="{DynamicResource StatusWarningForegroundBrush}"
                             FontSize="12"
                             TextWrapping="Wrap"/>
                </StackPanel>
              </DataTemplate>

              <!-- Save Location Step -->
              <DataTemplate DataType="steps:SaveLocationStepViewModel">
                <StackPanel Spacing="16">
                  <StackPanel Spacing="6">
                    <TextBlock Text="Quick Select" Classes="WizardSectionHeader" Margin="0"/>
                    <WrapPanel>
                      <Button Content="Pictures/Screenshots"
                              Command="{Binding SelectPresetCommand}"
                              CommandParameter="{Binding QuickSelectPaths[0]}"
                              Classes="WizardGhostButton"
                              Margin="0,0,8,8"/>
                      <Button Content="Desktop"
                              Command="{Binding SelectPresetCommand}"
                              CommandParameter="{Binding QuickSelectPaths[1]}"
                              Classes="WizardGhostButton"
                              Margin="0,0,8,8"/>
                      <Button Content="Documents"
                              Command="{Binding SelectPresetCommand}"
                              CommandParameter="{Binding QuickSelectPaths[2]}"
                              Classes="WizardGhostButton"
                              Margin="0,0,8,8"/>
                    </WrapPanel>
                  </StackPanel>

                  <StackPanel Spacing="6">
                    <TextBlock Text="Folder Path" Classes="WizardSectionHeader" Margin="0"/>
                    <Grid ColumnDefinitions="*,Auto">
                      <TextBox Grid.Column="0"
                               Text="{Binding SelectedPath}"
                               Watermark="Select a folder..."
                               Classes="WizardInput"/>
                      <Button Grid.Column="1"
                              Content="Browse..."
                              Command="{Binding BrowseCommand}"
                              Classes="WizardGhostButton"
                              Margin="8,0,0,0"/>
                    </Grid>
                  </StackPanel>

                  <StackPanel Spacing="4">
                    <TextBlock Text="Preview:" Classes="WizardSectionHint" Margin="0"/>
                    <TextBlock Text="{Binding PathPreview}"
                               Classes="WizardPathPreview"
                               TextTrimming="CharacterEllipsis"/>
                  </StackPanel>

                  <CheckBox Content="Create date subfolders"
                            IsChecked="{Binding CreateDateSubfolders}"
                            Classes="WizardCheckBox"/>

                  <TextBlock Text="{Binding PathError}"
                             IsVisible="{Binding PathError, Converter={StaticResource StringNotEmptyConverter}}"
                             Foreground="{DynamicResource StatusErrorForegroundBrush}"
                             FontSize="12"/>
                </StackPanel>
              </DataTemplate>

              <!-- Hotkey Step -->
              <DataTemplate DataType="steps:HotkeyStepViewModel">
                <StackPanel Spacing="16">
                  <StackPanel Spacing="6">
                    <TextBlock Text="Primary Capture Hotkey" Classes="WizardSectionHeader" Margin="0"/>
                    <Border Background="{DynamicResource ControlFillColorDefaultBrush}"
                            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="16,12"
                            HorizontalAlignment="Left">
                      <TextBlock Text="{Binding PrimaryHotkey}"
                                 FontFamily="JetBrains Mono, Consolas, monospace"
                                 FontSize="18"
                                 FontWeight="SemiBold"/>
                    </Border>
                  </StackPanel>

                  <Border Classes="status-warning"
                          Padding="12"
                          IsVisible="{Binding HasConflict}">
                    <TextBlock Text="{Binding ConflictMessage}"
                               Foreground="{DynamicResource StatusWarningForegroundBrush}"
                               TextWrapping="Wrap"/>
                  </Border>

                  <Expander Header="Additional Hotkeys" Classes="WizardExpander">
                    <StackPanel Spacing="8" Margin="0,12,0,0">
                      <ItemsControl ItemsSource="{Binding SecondaryHotkeys}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate>
                            <Grid ColumnDefinitions="*,Auto" Margin="0,4">
                              <StackPanel Grid.Column="0">
                                <TextBlock Text="{Binding Name}" FontWeight="Medium"/>
                                <TextBlock Text="{Binding Description}" FontSize="12" Opacity="0.7"/>
                              </StackPanel>
                              <Border Grid.Column="1"
                                      Background="{DynamicResource ControlFillColorDefaultBrush}"
                                      BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                      BorderThickness="1"
                                      CornerRadius="4"
                                      Padding="8,4">
                                <TextBlock Text="{Binding Hotkey}"
                                           FontFamily="JetBrains Mono, Consolas, monospace"/>
                              </Border>
                            </Grid>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </StackPanel>
                  </Expander>

                  <Button Content="Test Hotkey"
                          Command="{Binding TestHotkeyCommand}"
                          Classes="WizardGhostButton"
                          HorizontalAlignment="Left"/>
                </StackPanel>
              </DataTemplate>

              <!-- Upload Step -->
              <DataTemplate DataType="steps:UploadStepViewModel">
                <StackPanel Spacing="16">
                  <StackPanel Spacing="6">
                    <TextBlock Text="Upload Destination" Classes="WizardSectionHeader" Margin="0"/>
                    <ItemsControl ItemsSource="{Binding AvailableUploaders}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <Border Classes="WizardRadioCard"
                                  Margin="0,4"
                                  Padding="12">
                            <RadioButton GroupName="UploaderSelection"
                                         IsChecked="{Binding IsSelected}"
                                         HorizontalAlignment="Stretch">
                              <Grid ColumnDefinitions="Auto,*">
                                <TextBlock Grid.Column="0"
                                           Text="IMG"
                                           FontFamily="avares://ShareX.ImageEditor/Assets#lucide"
                                           FontSize="16"
                                           Margin="0,0,12,0"
                                           VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1">
                                  <TextBlock Text="{Binding Name}" FontWeight="Medium"/>
                                  <TextBlock Text="{Binding Description}" FontSize="12" Opacity="0.7"/>
                                </StackPanel>
                              </Grid>
                            </RadioButton>
                          </Border>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>

                  <Button Content="Import from ShareX..."
                          Command="{Binding ImportFromShareXCommand}"
                          IsVisible="{Binding HasShareXConfig}"
                          Classes="WizardGhostButton"
                          HorizontalAlignment="Left"
                          Margin="0,8,0,0"/>

                  <Border Classes="status-success"
                          Padding="12"
                          IsVisible="{Binding TestResult, Converter={StaticResource StringNotEmptyConverter}}">
                    <TextBlock Text="{Binding TestResult}"
                               Foreground="{Binding IsTestSuccessful, Converter={StaticResource BoolToSuccessErrorBrushConverter}}"
                               TextWrapping="Wrap"/>
                  </Border>

                  <Button Command="{Binding TestConnectionCommand}"
                          IsEnabled="{Binding IsTestingConnection, Converter={StaticResource InverseBoolConverter}}"
                          Classes="WizardGhostButton"
                          HorizontalAlignment="Left">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <ProgressBar IsIndeterminate="True"
                                   IsVisible="{Binding IsTestingConnection}"
                                   Width="16" Height="16"/>
                      <TextBlock Text="{Binding IsTestingConnection, Converter={StaticResource BoolToStringConverter}, ConverterParameter='Testing...|Test Connection'}"/>
                    </StackPanel>
                  </Button>
                </StackPanel>
              </DataTemplate>

              <!-- OCR Step -->
              <DataTemplate DataType="steps:OcrStepViewModel">
                <StackPanel Spacing="16">
                  <StackPanel Spacing="6">
                    <TextBlock Text="Select Languages for OCR" Classes="WizardSectionHeader" Margin="0"/>
                    <ItemsControl ItemsSource="{Binding AvailableLanguages}">
                      <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                          <WrapPanel/>
                        </ItemsPanelTemplate>
                      </ItemsControl.ItemsPanel>
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <ToggleButton Content="{Binding DisplayName}"
                                        Classes="WizardLanguageChip"
                                        Margin="4">
                            <ToggleButton.IsChecked>
                              <MultiBinding Converter="{StaticResource ListContainsConverter}">
                                <Binding Path="($parent[ItemsControl].((steps:OcrStepViewModel)DataContext).SelectedLanguages)"/>
                                <Binding Path="LanguageTag"/>
                              </MultiBinding>
                            </ToggleButton.IsChecked>
                          </ToggleButton>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>

                  <Border Classes="status-warning"
                          Padding="12"
                          IsVisible="{Binding ExceedsRecommendedSize}">
                    <TextBlock Text="{Binding TotalDownloadSizeMb, StringFormat='Selected languages will require approximately {0} MB of downloads.'}"
                               Foreground="{DynamicResource StatusWarningForegroundBrush}"
                               TextWrapping="Wrap"/>
                  </Border>

                  <CheckBox Content="Download language data in the background"
                            IsChecked="{Binding DownloadInBackground}"
                            Classes="WizardCheckBox"/>
                </StackPanel>
              </DataTemplate>

              <!-- Complete Step -->
              <DataTemplate DataType="steps:CompleteStepViewModel">
                <StackPanel Spacing="16">
                  <StackPanel Spacing="8" HorizontalAlignment="Center" Margin="0,16,0,0">
                    <Border Width="64" Height="64"
                            Background="{DynamicResource AccentFillColorSecondaryBrush}"
                            CornerRadius="32"
                            HorizontalAlignment="Center">
                      <TextBlock Text="✓"
                                 FontSize="32"
                                 FontWeight="Bold"
                                 HorizontalAlignment="Center" VerticalAlignment="Center"
                                 Foreground="{DynamicResource AccentFillColorDefaultBrush}"/>
                    </Border>
                    <TextBlock Text="You're all set up!"
                               FontSize="20"
                               FontWeight="SemiBold"
                               HorizontalAlignment="Center"/>
                  </StackPanel>

                  <TextBlock Text="{Binding SummaryText}"
                             TextWrapping="Wrap"
                             Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>

                  <CheckBox Content="Show tips on startup"
                            IsChecked="{Binding ShowTipsOnStartup}"
                            Classes="WizardCheckBox"/>

                  <StackPanel Orientation="Horizontal" Spacing="12">
                    <Button Content="Take First Screenshot"
                            Command="{Binding TakeFirstScreenshotCommand}"
                            Classes="WizardPrimaryButton"/>
                    <Button Content="Open Settings"
                            Command="{Binding OpenSettingsCommand}"
                            Classes="WizardGhostButton"/>
                  </StackPanel>
                </StackPanel>
              </DataTemplate>
            </ContentControl.DataTemplates>
          </ContentControl>
        </StackPanel>
      </ScrollViewer>
    </Border>

    <!-- Skip This Step Link -->
    <Button Grid.Row="3"
            Content="Skip this step"
            Command="{Binding SkipCommand}"
            IsVisible="{Binding CurrentStep.CanSkip}"
            Classes="WizardSkipLink"
            HorizontalAlignment="Left"
            Margin="0,0,0,8"/>

    <!-- Footer Buttons -->
    <Grid Grid.Row="4" ColumnDefinitions="Auto,*,Auto,Auto">
      <Button Grid.Column="0"
              Content="Back"
              Command="{Binding BackCommand}"
              Classes="WizardGhostButton"
              IsVisible="{Binding CanGoBack}"/>

      <Button Grid.Column="2"
              Content="Skip All"
              Command="{Binding SkipAllCommand}"
              Classes="WizardGhostButton"
              IsVisible="{Binding CanSkipAll}"
              Margin="0,0,8,0"/>

      <Button Grid.Column="3"
              Content="{Binding NextButtonText}"
              Command="{Binding NextCommand}"
              IsEnabled="{Binding CurrentStep.IsValid}"
              Classes="WizardPrimaryButton"/>
    </Grid>

  </Grid>

</Window>