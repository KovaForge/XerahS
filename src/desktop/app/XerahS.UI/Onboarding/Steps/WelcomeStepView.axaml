<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:XerahS.UI.Onboarding.ViewModels.Steps"
             mc:Ignorable="d"
             x:Class="XerahS.UI.Onboarding.Steps.WelcomeStepView"
             d:DesignWidth="560"
             d:DesignHeight="320"
             x:DataType="vm:WelcomeStepViewModel">

  <UserControl.Styles>
    <StyleInclude Source="/Onboarding/Styles/OnboardingStyles.axaml" />
  </UserControl.Styles>

  <StackPanel Spacing="0">
    <StackPanel Orientation="Horizontal" Spacing="16" Margin="0,0,0,32">
      <Border Width="48" Height="48"
              Background="{DynamicResource WizAccentSubtle}"
              CornerRadius="24"
              HorizontalAlignment="Left">
        <TextBlock Text="🌍" FontSize="22"
                   HorizontalAlignment="Center" VerticalAlignment="Center" />
      </Border>
      <StackPanel VerticalAlignment="Center">
        <TextBlock Text="Language &amp; Region" Classes="WizardStepTitle" />
        <TextBlock Text="Set your preferred language" Classes="WizardStepSubtitle" />
      </StackPanel>
    </StackPanel>

    <StackPanel Spacing="6">
      <TextBlock Text="Display Language"
                 FontSize="13" FontWeight="Medium"
                 Foreground="{DynamicResource WizTextPrimary}" />
      <ComboBox x:Name="LanguageCombo"
                Classes="WizardComboBox"
                ItemsSource="{Binding AvailableLanguages}"
                HorizontalAlignment="Stretch" Height="48"
                SelectionChanged="OnLanguageComboSelectionChanged">
        <ComboBox.ItemTemplate>
          <DataTemplate x:DataType="vm:LanguageOption">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <TextBlock Text="{Binding DisplayName}" FontSize="15" />
              <TextBlock Text="{Binding NativeName}" FontSize="12"
                         Foreground="{DynamicResource WizTextSecondary}" />
            </StackPanel>
          </DataTemplate>
        </ComboBox.ItemTemplate>
      </ComboBox>
    </StackPanel>

    <TextBlock Text="Showing all available languages"
               FontSize="12" Foreground="{DynamicResource WizTextSecondary}" Margin="0,6,0,0" />
  </StackPanel>

</UserControl>
