<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:XerahS.UI.Onboarding.ViewModels.Steps"
             mc:Ignorable="d"
             x:Class="XerahS.UI.Onboarding.Steps.WelcomeStepView"
             d:DesignWidth="560"
             d:DesignHeight="320"
             x:DataType="vm:WelcomeStepViewModel">

  <UserControl.Styles>
    <StyleInclude Source="/Onboarding/Styles/OnboardingStyles.axaml" />
  </UserControl.Styles>

  <StackPanel Spacing="0">
    <StackPanel Orientation="Horizontal" Spacing="16" Margin="0,0,0,24">
      <Border Width="48" Height="48"
              Background="{DynamicResource WizAccentSubtle}"
              CornerRadius="24"
              HorizontalAlignment="Left">
        <TextBlock Text="📸"
                   FontSize="22"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center" />
      </Border>
      <StackPanel VerticalAlignment="Center" Spacing="4">
        <TextBlock Text="Welcome to XerahS"
                   Classes="WizardStepTitle" />
        <TextBlock Text="A few quick steps to get started"
                   Classes="WizardStepSubtitle" />
      </StackPanel>
    </StackPanel>

    <TextBlock Text="We'll walk you through:"
               FontSize="13"
               FontWeight="Medium"
               Foreground="{DynamicResource WizTextPrimary}"
               Margin="0,0,0,8" />

    <StackPanel Spacing="6" Margin="4,0,0,0">
      <TextBlock Text="• Where screenshots are saved"
                 FontSize="13"
                 Foreground="{DynamicResource WizTextSecondary}" />
      <TextBlock Text="• Capture hotkeys"
                 FontSize="13"
                 Foreground="{DynamicResource WizTextSecondary}" />
      <TextBlock Text="• Upload destination"
                 FontSize="13"
                 Foreground="{DynamicResource WizTextSecondary}" />
      <TextBlock Text="• OCR languages"
                 FontSize="13"
                 Foreground="{DynamicResource WizTextSecondary}" />
    </StackPanel>

    <TextBlock Text="You can change any of these later in Settings."
               FontSize="12"
               Foreground="{DynamicResource WizTextSecondary}"
               Margin="0,16,0,0"
               TextWrapping="Wrap" />
  </StackPanel>

</UserControl>
