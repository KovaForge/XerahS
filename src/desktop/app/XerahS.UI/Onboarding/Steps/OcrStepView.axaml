<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="using:XerahS.UI.Onboarding.Steps"
             xmlns:vm="using:XerahS.UI.Onboarding.ViewModels.Steps"
             mc:Ignorable="d"
             x:Class="XerahS.UI.Onboarding.Steps.OcrStepView"
             x:DataType="vm:OcrStepViewModel"
             d:DesignWidth="560"
             d:DesignHeight="440">

  <UserControl.Styles>
    <StyleInclude Source="/Onboarding/Styles/OnboardingStyles.axaml" />
  </UserControl.Styles>

  <StackPanel Spacing="0">
    <StackPanel Orientation="Horizontal" Spacing="16" Margin="0,0,0,32">
      <TextBlock Text="📝" FontSize="32" VerticalAlignment="Center" />
      <StackPanel VerticalAlignment="Center">
        <TextBlock Text="Text Recognition (OCR)" Classes="WizardStepTitle" />
        <TextBlock Text="Select languages for text extraction" Classes="WizardStepSubtitle" />
      </StackPanel>
    </StackPanel>

    <Border Margin="0,0,0,16" Padding="12,10" CornerRadius="6"
            Background="{DynamicResource WizBg}">
      <TextBlock Text="You'll be able to extract text from screenshots using your hotkey + T"
                 FontSize="12"
                 Foreground="{DynamicResource WizTextSecondary}"
                 TextWrapping="Wrap" />
    </Border>

    <Border MaxHeight="220" CornerRadius="8"
            BorderBrush="{DynamicResource WizBorder}" BorderThickness="1">
      <ScrollViewer>
        <ItemsControl ItemsSource="{Binding AvailableLanguages}" Padding="4">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:OcrLanguageOption">
              <Grid ColumnDefinitions="Auto,*,Auto" Margin="8,6" MinHeight="36">
                <CheckBox Grid.Column="0"
                          IsChecked="{Binding IsSelected}"
                          Margin="0,0,12,0" VerticalAlignment="Center"
                          Tag="{Binding LanguageTag}" />
                <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                  <TextBlock Text="{Binding DisplayName}"
                             FontSize="14"
                             Foreground="{DynamicResource WizTextPrimary}" />
                  <TextBlock Text="{Binding NativeName}"
                             FontSize="11"
                             Foreground="{DynamicResource WizTextSecondary}" />
                </StackPanel>
                <TextBlock Grid.Column="2"
                           Text="{Binding DownloadSizeMb, StringFormat='~{0} MB'}"
                           FontSize="12"
                           Foreground="{DynamicResource WizTextSecondary}"
                           VerticalAlignment="Center" />
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
    </Border>

    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,12,0,0">
      <TextBlock Text="Total size:" FontSize="13"
                 Foreground="{DynamicResource WizTextSecondary}"
                 VerticalAlignment="Center" />
      <TextBlock Text="{Binding TotalDownloadSizeMb, StringFormat='~{0} MB'}"
                 FontSize="13" FontWeight="SemiBold"
                 Foreground="{DynamicResource WizTextPrimary}"
                 VerticalAlignment="Center" />
    </StackPanel>

    <Border Classes="WizardWarningCard" Margin="0,12,0,0" IsVisible="{Binding ExceedsRecommendedSize}">
      <StackPanel Orientation="Horizontal" Spacing="8">
        <TextBlock Text="⚠" FontSize="14" VerticalAlignment="Center"
                   Foreground="{DynamicResource WizWarning}" />
        <TextBlock Text="Total exceeds 200 MB — consider deselecting some languages"
                   FontSize="13"
                   Foreground="{DynamicResource WizWarning}"
                   TextWrapping="Wrap" />
      </StackPanel>
    </Border>

    <CheckBox Classes="WizardCheckBox" Content="Download in background"
              IsChecked="{Binding DownloadInBackground}" Margin="0,16,0,0" />
  </StackPanel>

</UserControl>
