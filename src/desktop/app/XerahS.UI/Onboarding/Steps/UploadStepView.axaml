<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             x:Class="XerahS.UI.Onboarding.Steps.UploadStepView"
             d:DesignWidth="560"
             d:DesignHeight="440">

  <StackPanel Spacing="0">
    <StackPanel Orientation="Horizontal" Spacing="16" Margin="0,0,0,32">
      <TextBlock Text="☁" FontSize="32" VerticalAlignment="Center" />
      <StackPanel VerticalAlignment="Center">
        <TextBlock Text="Upload Destination" Classes="wiz-step-title" />
        <TextBlock Text="Where should screenshots go by default?" Classes="wiz-step-subtitle" />
      </StackPanel>
    </StackPanel>

    <ItemsControl x:Name="UploadersList" ItemsSource="{Binding AvailableUploaders}">
      <ItemsControl.ItemTemplate>
        <DataTemplate>
          <Border Classes="wiz-radio-card" PointerPressed="OnCardPointerPressed"
                 Margin="0,0,0,8" Padding="16">
            <Grid ColumnDefinitions="Auto,*,Auto">
              <RadioButton Grid.Column="0" GroupName="UploadDest"
                           IsChecked="False"
                           VerticalAlignment="Center" Margin="0,0,12,0"
                           Tag="{Binding}" />
              <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <TextBlock Text="{Binding Icon}" FontSize="18" VerticalAlignment="Center" />
                  <TextBlock Text="{Binding Name}" FontFamily="DM Sans, system-ui" FontSize="15" FontWeight="Medium"
                             Foreground="{DynamicResource XerahS.Onboarding.Brush.Text.Primary}" />
                </StackPanel>
                <TextBlock Text="{Binding Description}" FontFamily="DM Sans, system-ui" FontSize="12"
                           Foreground="{DynamicResource XerahS.Onboarding.Brush.Text.Secondary}"
                           Margin="26,0,0,0" />
              </StackPanel>
            </Grid>
          </Border>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>

    <!-- Test Result -->
    <Border x:Name="TestResultBorder" Margin="0,8,0,0" Padding="12,10" CornerRadius="6"
            Background="{DynamicResource XerahS.Onboarding.Brush.Success.Subtle}"
            IsVisible="{Binding TestResult, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
      <TextBlock Text="{Binding TestResult}"
                 FontFamily="DM Sans, system-ui" FontSize="13"
                 Foreground="{DynamicResource XerahS.Onboarding.Brush.Success}"
                 TextWrapping="Wrap" />
    </Border>

    <!-- ShareX import (conditional) -->
    <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,16,0,0"
                IsVisible="{Binding HasShareXConfig}">
      <Button Classes="wiz-btn-ghost" Content="Import from ShareX"
              Command="{Binding ImportFromShareXCommand}" />
      <TextBlock Text="ShareX configuration detected" Classes="wiz-hint" VerticalAlignment="Center" />
    </StackPanel>

    <Button Classes="wiz-btn-sm" Content="Test Connection"
            Command="{Binding TestConnectionCommand}" Margin="0,12,0,0"
            HorizontalAlignment="Left" />

    <Border Margin="0,20,0,0" Padding="12,10" CornerRadius="6"
            Background="{DynamicResource XerahS.Onboarding.Brush.Background}">
      <TextBlock Text="Your images are only uploaded when you explicitly choose 'Upload'"
                 FontFamily="DM Sans, system-ui" FontSize="12"
                 Foreground="{DynamicResource XerahS.Onboarding.Brush.Text.Secondary}"
                 TextWrapping="Wrap" />
    </Border>
  </StackPanel>

</UserControl>
