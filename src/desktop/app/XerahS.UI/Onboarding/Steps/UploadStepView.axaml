<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:XerahS.UI.Onboarding.ViewModels.Steps"
             mc:Ignorable="d"
             x:Class="XerahS.UI.Onboarding.Steps.UploadStepView"
             x:DataType="vm:UploadStepViewModel"
             d:DesignWidth="560"
             d:DesignHeight="440">

  <UserControl.Styles>
    <StyleInclude Source="/Onboarding/Styles/OnboardingStyles.axaml" />
  </UserControl.Styles>

  <StackPanel Spacing="0">
    <StackPanel Orientation="Horizontal" Spacing="16" Margin="0,0,0,32">
      <TextBlock Text="☁" FontSize="32" VerticalAlignment="Center" />
      <StackPanel VerticalAlignment="Center">
        <TextBlock Text="Upload Destination" Classes="WizardStepTitle" />
        <TextBlock Text="Where should screenshots go by default?" Classes="WizardStepSubtitle" />
      </StackPanel>
    </StackPanel>

    <ItemsControl x:Name="UploadersList" ItemsSource="{Binding AvailableUploaders}">
      <ItemsControl.ItemTemplate>
        <DataTemplate x:DataType="vm:UploaderOption">
          <Border Classes="WizardRadioCard" PointerPressed="OnCardPointerPressed"
                 Tag="{Binding}"
                 Margin="0,0,0,8" Padding="16">
            <Grid ColumnDefinitions="Auto,*,Auto">
              <RadioButton Grid.Column="0" GroupName="UploadDest"
                           IsChecked="{Binding IsSelected, Mode=TwoWay}"
                           VerticalAlignment="Center" Margin="0,0,12,0"
                           Tag="{Binding}" />
              <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <TextBlock Text="{Binding Icon}" FontSize="18" VerticalAlignment="Center" />
                  <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="Medium"
                             Foreground="{DynamicResource WizTextPrimary}" />
                </StackPanel>
                <TextBlock Text="{Binding Description}" FontSize="12"
                           Foreground="{DynamicResource WizTextSecondary}"
                           Margin="26,0,0,0" />
              </StackPanel>
              <Button Grid.Column="2"
                      Content="Config..."
                      Command="{Binding $parent[ItemsControl].DataContext.ConfigureUploaderCommand}"
                      CommandParameter="{Binding}"
                      Classes="WizardGhostButton"
                      IsEnabled="{Binding IsSelected}"
                      IsVisible="{Binding CanConfigure}"
                      VerticalAlignment="Center" />
            </Grid>
          </Border>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>

    <!-- Test Result -->
    <Border x:Name="TestResultBorder" Margin="0,8,0,0" Padding="12,10" CornerRadius="6"
            Background="{DynamicResource WizSuccessSubtle}"
            IsVisible="{Binding HasTestResult}">
      <TextBlock Text="{Binding TestResult}"
                 FontSize="13"
                 Foreground="{DynamicResource WizSuccess}"
                 TextWrapping="Wrap" />
    </Border>

    <!-- ShareX import (conditional) -->
    <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,16,0,0"
                IsVisible="{Binding HasShareXConfig}">
      <Button Classes="WizardGhostButton" Content="Import from ShareX"
              Command="{Binding ImportFromShareXCommand}" />
      <TextBlock Text="ShareX configuration detected" FontSize="12" Foreground="{DynamicResource WizTextSecondary}" VerticalAlignment="Center" />
    </StackPanel>

    <Button Classes="WizardGhostButton" Content="Test Connection"
            Command="{Binding TestConnectionCommand}" Margin="0,12,0,0"
            HorizontalAlignment="Left" />

    <Border Margin="0,20,0,0" Padding="12,10" CornerRadius="6"
            Background="{DynamicResource WizBg}">
      <TextBlock Text="Your images are only uploaded when you explicitly choose 'Upload'"
                 FontSize="12"
                 Foreground="{DynamicResource WizTextSecondary}"
                 TextWrapping="Wrap" />
    </Border>
  </StackPanel>

</UserControl>
