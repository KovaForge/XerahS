<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:XerahS.UI.Onboarding.ViewModels.Steps"
             xmlns:controls="using:XerahS.UI.Onboarding.Controls"
             mc:Ignorable="d"
             x:Class="XerahS.UI.Onboarding.Steps.SaveLocationStepView"
             d:DesignWidth="560"
             d:DesignHeight="380"
             x:DataType="vm:SaveLocationStepViewModel">

  <UserControl.Styles>
    <StyleInclude Source="/Onboarding/Styles/OnboardingStyles.axaml" />
  </UserControl.Styles>

  <StackPanel Spacing="0">
    <StackPanel Orientation="Horizontal" Spacing="16" Margin="0,0,0,32">
      <Border Width="48" Height="48"
              Background="{DynamicResource WizAccentSubtle}"
              CornerRadius="24"
              HorizontalAlignment="Left">
        <TextBlock Text="📁" FontSize="22"
                   HorizontalAlignment="Center" VerticalAlignment="Center" />
      </Border>
      <StackPanel VerticalAlignment="Center">
        <TextBlock Text="Save Location" Classes="WizardStepTitle" />
        <TextBlock Text="Where should screenshots go?" Classes="WizardStepSubtitle" />
      </StackPanel>
    </StackPanel>

    <!-- Directory Picker -->
    <StackPanel Spacing="8">
      <TextBlock Text="Screenshots folder:"
                 FontSize="13" FontWeight="Medium"
                 Foreground="{DynamicResource WizTextPrimary}" />
      <controls:DirectoryPicker Value="{Binding SelectedPath, Mode=TwoWay}" />
    </StackPanel>

    <!-- Date Subfolder -->
    <CheckBox Classes="WizardCheckBox" Content="Create subfolder with today's date"
              IsChecked="{Binding CreateDateSubfolders, Mode=TwoWay}" Margin="0,16,0,0" />

    <!-- Path Preview -->
    <Border Margin="0,16,0,0" Padding="12,10" CornerRadius="6"
            Background="{DynamicResource WizBg}"
            IsVisible="{Binding HasPathPreview}">
      <StackPanel Spacing="4">
        <TextBlock Text="Preview:" FontSize="11"
                   Foreground="{DynamicResource WizTextSecondary}" />
        <TextBlock Text="{Binding PathPreview}"
                   FontFamily="JetBrains Mono, Consolas, monospace" FontSize="13"
                   Foreground="{DynamicResource WizTextPrimary}" />
      </StackPanel>
    </Border>

    <!-- Error -->
    <Border Classes="WizardConflictCard" Margin="0,12,0,0"
            IsVisible="{Binding !IsPathWritable}">
      <StackPanel Orientation="Horizontal" Spacing="8">
        <TextBlock Text="⚠" FontSize="14" VerticalAlignment="Center"
                   Foreground="{DynamicResource WizDanger}" />
        <TextBlock Text="This path is not writable"
                   FontSize="13"
                   Foreground="{DynamicResource WizDanger}" />
      </StackPanel>
    </Border>
  </StackPanel>

</UserControl>
