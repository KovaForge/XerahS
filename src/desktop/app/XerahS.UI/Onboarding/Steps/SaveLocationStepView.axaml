<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:XerahS.UI.Onboarding.ViewModels.Steps"
             xmlns:controls="using:XerahS.UI.Onboarding.Controls"
             mc:Ignorable="d"
             x:Class="XerahS.UI.Onboarding.Steps.SaveLocationStepView"
             d:DesignWidth="560"
             d:DesignHeight="380"
             x:DataType="vm:SaveLocationStepViewModel">

  <StackPanel Spacing="0">
    <StackPanel Orientation="Horizontal" Spacing="16" Margin="0,0,0,32">
      <Border Width="48" Height="48"
              Background="{DynamicResource XerahS.Onboarding.Brush.Accent.Subtle}"
              CornerRadius="24"
              HorizontalAlignment="Left">
        <TextBlock Text="📁" FontSize="22"
                   HorizontalAlignment="Center" VerticalAlignment="Center" />
      </Border>
      <StackPanel VerticalAlignment="Center">
        <TextBlock Text="Save Location" Classes="wiz-step-title" />
        <TextBlock Text="Where should screenshots go?" Classes="wiz-step-subtitle" />
      </StackPanel>
    </StackPanel>

    <!-- Directory Picker -->
    <StackPanel Spacing="8">
      <TextBlock Text="Screenshots folder:"
                 FontFamily="DM Sans, system-ui" FontSize="13" FontWeight="Medium"
                 Foreground="{DynamicResource XerahS.Onboarding.Brush.Text.Primary}" />
      <controls:DirectoryPicker Value="{Binding SelectedPath, Mode=TwoWay}" />
    </StackPanel>

    <!-- Quick Select -->
    <StackPanel Spacing="8" Margin="0,16,0,0">
      <TextBlock Text="Quick select:"
                 FontFamily="DM Sans, system-ui" FontSize="12"
                 Foreground="{DynamicResource XerahS.Onboarding.Brush.Text.Secondary}" />
      <StackPanel Orientation="Horizontal" Spacing="8">
        <Button Classes="wiz-btn-sm" Tag="Pictures" Click="OnQuickSelectClicked">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <TextBlock Text="📷" FontSize="14" VerticalAlignment="Center" />
            <TextBlock Text="Pictures" FontSize="13" VerticalAlignment="Center" />
          </StackPanel>
        </Button>
        <Button Classes="wiz-btn-sm" Tag="Desktop" Click="OnQuickSelectClicked">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <TextBlock Text="🖥️" FontSize="14" VerticalAlignment="Center" />
            <TextBlock Text="Desktop" FontSize="13" VerticalAlignment="Center" />
          </StackPanel>
        </Button>
        <Button Classes="wiz-btn-sm" Tag="Documents" Click="OnQuickSelectClicked">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <TextBlock Text="📄" FontSize="14" VerticalAlignment="Center" />
            <TextBlock Text="Documents" FontSize="13" VerticalAlignment="Center" />
          </StackPanel>
        </Button>
      </StackPanel>
    </StackPanel>

    <!-- Date Subfolder -->
    <CheckBox Classes="wiz-check" Content="Create subfolder with today's date"
              IsChecked="{Binding CreateDateSubfolders, Mode=TwoWay}" Margin="0,16,0,0" />

    <!-- Path Preview -->
    <Border Margin="0,16,0,0" Padding="12,10" CornerRadius="6"
            Background="{DynamicResource XerahS.Onboarding.Brush.Background}"
            IsVisible="{Binding !string.IsNullOrEmpty(PathPreview)}">
      <StackPanel Spacing="4">
        <TextBlock Text="Preview:" FontSize="11" FontFamily="DM Sans, system-ui"
                   Foreground="{DynamicResource XerahS.Onboarding.Brush.Text.Secondary}" />
        <TextBlock Text="{Binding PathPreview}"
                   FontFamily="JetBrains Mono, Consolas, monospace" FontSize="13"
                   Foreground="{DynamicResource XerahS.Onboarding.Brush.Text.Primary}" />
      </StackPanel>
    </Border>

    <!-- Error -->
    <Border Classes="wiz-conflict-card" Margin="0,12,0,0"
            IsVisible="{Binding !IsPathWritable}">
      <StackPanel Orientation="Horizontal" Spacing="8">
        <TextBlock Text="⚠" FontSize="14" VerticalAlignment="Center"
                   Foreground="{DynamicResource XerahS.Onboarding.Brush.Danger}" />
        <TextBlock Text="This path is not writable"
                   FontFamily="DM Sans, system-ui" FontSize="13"
                   Foreground="{DynamicResource XerahS.Onboarding.Brush.Danger}" />
      </StackPanel>
    </Border>
  </StackPanel>

</UserControl>
