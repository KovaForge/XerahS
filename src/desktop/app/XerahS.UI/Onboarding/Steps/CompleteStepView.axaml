<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="using:XerahS.UI.Onboarding.Steps"
             xmlns:vm="using:XerahS.UI.Onboarding.ViewModels.Steps"
             xmlns:converters="using:XerahS.UI.Converters"
             mc:Ignorable="d" d:DesignWidth="560" d:DesignHeight="440"
             x:Class="XerahS.UI.Onboarding.Steps.CompleteStepView"
             x:DataType="vm:CompleteStepViewModel">
  <UserControl.Styles>
    <StyleInclude Source="/Onboarding/Styles/OnboardingStyles.axaml" />
  </UserControl.Styles>

  <ScrollViewer HorizontalScrollBarVisibility="Disabled"
               VerticalScrollBarVisibility="Auto">
    <StackPanel Spacing="24" Margin="8,0">

      <!-- Success Animation Area -->
      <StackPanel Spacing="16" HorizontalAlignment="Center">

        <!-- Animated checkmark circle -->
        <Grid Width="80" Height="80" HorizontalAlignment="Center">
          <!-- Background circle -->
          <Ellipse x:Name="SuccessCircle"
                   Width="80" Height="80"
                   Fill="{DynamicResource WizAccentSubtle}"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center" />

          <!-- Checkmark SVG path -->
          <Path x:Name="CheckMark"
                Data="M22,47 L35,60 L58,32"
                Stroke="{DynamicResource WizAccent}"
                StrokeThickness="4"
                StrokeLineCap="Round"
                StrokeLineJoin="Round"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                RenderOptions.BitmapScalingMode="HighQuality">
            <Path.RenderTransform>
              <TranslateTransform X="0" Y="0" />
            </Path.RenderTransform>
          </Path>
        </Grid>

        <!-- Title -->
        <StackPanel Spacing="4" HorizontalAlignment="Center">
          <TextBlock Classes="WizardStepTitle"
                     Text="You're all set!"
                     FontSize="22"
                     HorizontalAlignment="Center" />
          <TextBlock Classes="WizardStepSubtitle"
                     Text="{Binding ConfiguredStepCount, StringFormat='Configuration complete ({0} steps)'}"
                     HorizontalAlignment="Center" />
        </StackPanel>
      </StackPanel>

      <!-- Summary Card -->
      <Border Classes="WizardCard"
              Padding="20,16">
        <StackPanel Spacing="12">
          <TextBlock Text="Your configuration"
                     FontWeight="SemiBold"
                     FontSize="14"
                     Foreground="{DynamicResource WizTextSecondary}" />

          <ItemsControl ItemsSource="{Binding SummaryLines}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="x:String">
                <TextBlock Text="{Binding}"
                           FontSize="13"
                           Foreground="{DynamicResource WizTextPrimary}"
                           TextWrapping="Wrap"
                           Margin="0,4" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <!-- Show if we have no summary -->
          <TextBlock Text="No steps were configured."
                     FontSize="13"
                     Foreground="{DynamicResource WizTextSecondary}"
                     IsVisible="{Binding SummaryLines.Count, Converter={x:Static converters:CountToInverseVisibilityConverter.Instance}}" />
        </StackPanel>
      </Border>

      <!-- Tips toggle -->
      <CheckBox Classes="WizardCheckBox"
                IsChecked="{Binding ShowTipsOnStartup, Mode=TwoWay}"
                Padding="0">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <TextBlock Text="☑"
                     FontSize="14"
                     VerticalAlignment="Center"
                     IsVisible="{Binding ShowTipsOnStartup}" />
          <TextBlock Text="☐"
                     FontSize="14"
                     VerticalAlignment="Center"
                     IsVisible="{Binding !ShowTipsOnStartup}" />
          <TextBlock Text="Show tips on startup"
                     FontSize="14"
                     Foreground="{DynamicResource WizTextPrimary}"
                     VerticalAlignment="Center" />
        </StackPanel>
      </CheckBox>

      <!-- Action Buttons -->
      <StackPanel Spacing="12" HorizontalAlignment="Stretch">

        <!-- Primary CTA: Take first screenshot -->
        <Button x:Name="TakeScreenshotButton"
                Classes="WizardPrimaryButton"
                Command="{Binding TakeFirstScreenshotCommand}"
                HorizontalAlignment="Stretch"
                Height="52"
                FontSize="15">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBlock Text="📷" FontSize="16" VerticalAlignment="Center" />
            <TextBlock Text="Take your first screenshot →"
                       VerticalAlignment="Center" />
          </StackPanel>
        </Button>

        <!-- Secondary: Open settings -->
        <Button Classes="WizardGhostButton"
                Command="{Binding OpenSettingsCommand}"
                HorizontalAlignment="Stretch"
                Height="48">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBlock Text="⚙️" FontSize="14" VerticalAlignment="Center" />
            <TextBlock Text="Open full settings"
                       FontSize="14"
                       VerticalAlignment="Center" />
          </StackPanel>
        </Button>
      </StackPanel>

    </StackPanel>
  </ScrollViewer>
</UserControl>
