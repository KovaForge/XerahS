<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="using:XerahS.UI.Onboarding.Controls"
             mc:Ignorable="d"
             x:Class="XerahS.UI.Onboarding.Controls.DirectoryPicker"
             x:DataType="local:DirectoryPicker"
             d:DesignWidth="500"
             d:DesignHeight="56">

  <UserControl.Styles>
    <StyleInclude Source="/Onboarding/Styles/OnboardingStyles.axaml" />
  </UserControl.Styles>

  <StackPanel Spacing="8">
    <Border Classes="WizardDirectoryPicker"
            Background="{DynamicResource WizSurface}">

      <Grid ColumnDefinitions="*,Auto,Auto">
        <TextBox x:Name="PathTextBox"
                 Grid.Column="0"
                 Classes="WizardInput"
                 IsReadOnly="True"
                 Watermark="Select a folder..."
                 Text="{Binding Value, Mode=TwoWay}"
                 BorderThickness="0"
                 Background="Transparent"
                 Padding="14,0"
                 VerticalContentAlignment="Center"
                 ToolTip.Tip="{Binding Value}" />

        <Button Grid.Column="1"
                x:Name="BrowseButton"
                Content="Browse..."
                Classes="WizardGhostButton"
                Margin="0,0,4,0"
                Click="BrowseButton_Click" />

        <Button Grid.Column="2"
                x:Name="ClearButton"
                Content="✕"
                Background="Transparent"
                BorderThickness="0"
                Foreground="{DynamicResource WizTextSecondary}"
                FontSize="14"
                Padding="8,4"
                Margin="0,0,4,0"
                Click="ClearButton_Click"
                ToolTip.Tip="Clear" />
      </Grid>
    </Border>

    <TextBlock x:Name="ErrorTextBlock"
               Text="{Binding ErrorMessage}"
               FontSize="12"
               Foreground="{DynamicResource WizDanger}"
               IsVisible="{Binding !IsWritable}"
               Margin="4,0,0,0" />
  </StackPanel>

</UserControl>
