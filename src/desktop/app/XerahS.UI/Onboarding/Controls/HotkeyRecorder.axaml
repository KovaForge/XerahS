<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="using:XerahS.UI.Onboarding.Controls"
             mc:Ignorable="d" d:DesignWidth="400" d:DesignHeight="56"
             x:Class="XerahS.UI.Onboarding.Controls.HotkeyRecorder"
             x:DataType="local:HotkeyRecorder"
             Focusable="True"
             KeyDown="OnKeyDown">
  <UserControl.Styles>
    <StyleInclude Source="/Onboarding/Styles/OnboardingStyles.axaml" />
  </UserControl.Styles>

  <Border x:Name="RecorderBorder"
          Classes="WizardHotkeyRecorder"
          Background="{DynamicResource WizSurface}"
          BorderBrush="{DynamicResource WizBorder}"
          BorderThickness="1"
          CornerRadius="8"
          Height="56"
          Padding="16,0"
          Cursor="Hand">
    <Grid ColumnDefinitions="*,Auto">
      <StackPanel Grid.Column="0"
                  Orientation="Horizontal"
                  VerticalAlignment="Center"
                  Spacing="8">
        <TextBlock x:Name="PlaceholderText"
                   Text="Click to record hotkey..."
                   FontSize="14"
                   Foreground="{DynamicResource WizTextSecondary}" />

        <TextBlock x:Name="RecordedText"
                   Classes="WizardHotkeyDisplay"
                   IsVisible="False" />
      </StackPanel>

      <Button x:Name="ClearButton"
              Content="X"
              Classes="WizardGhostButton"
              Width="32"
              Height="32"
              Padding="0"
              VerticalAlignment="Center"
              HorizontalContentAlignment="Center"
              ToolTip.Tip="Clear hotkey"
              Click="OnClearClick"
              IsVisible="False" />
    </Grid>
  </Border>
</UserControl>
