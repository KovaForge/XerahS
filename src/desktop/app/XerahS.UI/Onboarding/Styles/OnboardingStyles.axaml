<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Styles.Resources>

    <!-- Fonts -->
    <FontFamily x:Key="WizFontFamily">avares://Avalonia.Fonts.Inter/Assets#Inter</FontFamily>
    <FontFamily x:Key="WizMonoFontFamily">avares://Avalonia.Fonts.JetBrainsMono/Assets#JetBrains Mono</FontFamily>

    <!-- Reduced motion check: animations collapse to instant when prefers-reduced-motion is set -->
    <x:Boolean x:Key="WizReduceMotion">false</x:Boolean>

  </Styles.Resources>

  <!-- ========== WINDOW STYLE ========== -->

  <Style Selector="Window#OnboardingWizardWindow">
    <Setter Property="Background" Value="{DynamicResource WizBg}" />
    <Setter Property="FontFamily" Value="{DynamicResource WizFontFamily}" />
    <Setter Property="Width" Value="640" />
    <Setter Property="Height" Value="520" />
    <Setter Property="MinWidth" Value="480" />
    <Setter Property="MinHeight" Value="440" />
    <Setter Property="MaxWidth" Value="800" />
    <Setter Property="MaxHeight" Value="640" />
    <Setter Property="WindowStartupLocation" Value="CenterScreen" />
    <Setter Property="SystemDecorations" Value="Full" />
    <Setter Property="CanResize" Value="True" />
    <Setter Property="ShowInTaskbar" Value="True" />
    <Setter Property="Title" Value="Welcome to XerahS" />
  </Style>

  <!-- ========== WIZARD CARD ========== -->

  <Style Selector="Border.WizardCard">
    <Setter Property="Background" Value="{DynamicResource WizSurface}" />
    <Setter Property="BorderBrush" Value="{DynamicResource WizBorder}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="12" />
    <Setter Property="Padding" Value="24" />
    <Setter Property="BoxShadow" Value="0 4 24 -8 #1A000000" />
  </Style>

  <!-- ========== BUTTON STYLES ========== -->

  <!-- Primary button -->
  <Style Selector="Button.WizardPrimaryButton">
    <Setter Property="Background" Value="{DynamicResource WizAccent}" />
    <Setter Property="Foreground" Value="#FFFFFF" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Height" Value="48" />
    <Setter Property="Padding" Value="24,0" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>

  <Style Selector="Button.WizardPrimaryButton:pointerover">
    <Setter Property="Background" Value="{DynamicResource WizAccentHover}" />
  </Style>

  <Style Selector="Button.WizardPrimaryButton:pressed">
    <Setter Property="Opacity" Value="0.88" />
  </Style>

  <Style Selector="Button.WizardPrimaryButton:disabled">
    <Setter Property="Opacity" Value="0.5" />
  </Style>

  <!-- Ghost/outline button -->
  <Style Selector="Button.WizardGhostButton">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource WizTextSecondary}" />
    <Setter Property="BorderBrush" Value="{DynamicResource WizBorder}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Height" Value="48" />
    <Setter Property="Padding" Value="20,0" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>

  <Style Selector="Button.WizardGhostButton:pointerover">
    <Setter Property="Background" Value="{DynamicResource WizBorder}" />
    <Setter Property="Foreground" Value="{DynamicResource WizTextPrimary}" />
  </Style>

  <Style Selector="Button.WizardGhostButton:pressed">
    <Setter Property="Opacity" Value="0.8" />
  </Style>

  <!-- Skip link text button -->
  <Style Selector="Button.WizardSkipLink">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource WizTextSecondary}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>

  <Style Selector="Button.WizardSkipLink:pointerover">
    <Setter Property="Foreground" Value="{DynamicResource WizAccent}" />
  </Style>

  <!-- ========== PROGRESS DOTS ========== -->

  <!-- Base progress dot -->
  <Style Selector="Ellipse.WizardProgressDot">
    <Setter Property="Width" Value="24" />
    <Setter Property="Height" Value="24" />
    <Setter Property="StrokeThickness" Value="2" />
    <Setter Property="Stroke" Value="{DynamicResource WizBorder}" />
    <Setter Property="Fill" Value="Transparent" />
  </Style>

  <!-- Current step dot (ring + pulse) -->
  <Style Selector="Ellipse.WizardProgressDotCurrent">
    <Setter Property="Stroke" Value="{DynamicResource WizAccent}" />
    <Setter Property="StrokeThickness" Value="2.5" />
    <Setter Property="Fill" Value="Transparent" />
  </Style>

  <!-- Completed step dot (filled + checkmark) -->
  <Style Selector="Ellipse.WizardProgressDotCompleted">
    <Setter Property="Stroke" Value="{DynamicResource WizAccent}" />
    <Setter Property="StrokeThickness" Value="0" />
    <Setter Property="Fill" Value="{DynamicResource WizAccent}" />
  </Style>

  <!-- Future step dot -->
  <Style Selector="Ellipse.WizardProgressDotFuture">
    <Setter Property="Stroke" Value="{DynamicResource WizBorder}" />
    <Setter Property="StrokeThickness" Value="2" />
    <Setter Property="Fill" Value="Transparent" />
  </Style>

  <!-- Connecting line between dots -->
  <Style Selector="Rectangle.WizardProgressLine">
    <Setter Property="Height" Value="2" />
    <Setter Property="Fill" Value="{DynamicResource WizBorder}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <Style Selector="Rectangle.WizardProgressLineCompleted">
    <Setter Property="Fill" Value="{DynamicResource WizAccent}" />
  </Style>

  <!-- ========== RADIO CARDS ========== -->

  <!-- Radio card base -->
  <Style Selector="Border.WizardRadioCard">
    <Setter Property="Background" Value="{DynamicResource WizSurface}" />
    <Setter Property="BorderBrush" Value="{DynamicResource WizBorder}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Padding" Value="12" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>

  <Style Selector="Border.WizardRadioCard:pointerover">
    <Setter Property="BorderBrush" Value="{DynamicResource WizAccent}" />
  </Style>

  <!-- Selected radio card -->
  <Style Selector="Border.WizardRadioCardSelected">
    <Setter Property="Background" Value="{DynamicResource WizAccentSubtle}" />
    <Setter Property="BorderBrush" Value="{DynamicResource WizAccent}" />
    <Setter Property="BorderThickness" Value="2" />
  </Style>

  <!-- RadioButton styling for cards -->
  <Style Selector="RadioButton.WizardRadioCardRadio">
    <Setter Property="Margin" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Background" Value="Transparent" />
  </Style>

  <!-- ========== INPUT STYLES ========== -->

  <!-- Base input style -->
  <Style Selector="TextBox.WizardInput">
    <Setter Property="Background" Value="{DynamicResource WizSurface}" />
    <Setter Property="BorderBrush" Value="{DynamicResource WizBorder}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Height" Value="48" />
    <Setter Property="Padding" Value="12,0" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="Foreground" Value="{DynamicResource WizTextPrimary}" />
  </Style>

  <Style Selector="TextBox.WizardInput:pointerover">
    <Setter Property="BorderBrush" Value="{DynamicResource WizAccent}" />
  </Style>

  <Style Selector="TextBox.WizardInput:focus">
    <Setter Property="BorderBrush" Value="{DynamicResource WizAccent}" />
    <Setter Property="BorderThickness" Value="2" />
  </Style>

  <!-- ComboBox style -->
  <Style Selector="ComboBox.WizardComboBox">
    <Setter Property="Background" Value="{DynamicResource WizSurface}" />
    <Setter Property="BorderBrush" Value="{DynamicResource WizBorder}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Height" Value="48" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="Foreground" Value="{DynamicResource WizTextPrimary}" />
  </Style>

  <Style Selector="ComboBox.WizardComboBox:pointerover">
    <Setter Property="BorderBrush" Value="{DynamicResource WizAccent}" />
  </Style>

  <!-- CheckBox style -->
  <Style Selector="CheckBox.WizardCheckBox">
    <Setter Property="Foreground" Value="{DynamicResource WizTextPrimary}" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="Padding" Value="8,0" />
  </Style>

  <!-- Toggle switch -->
  <Style Selector="ToggleSwitch.WizardToggle">
    <Setter Property="OnContent" Value="" />
    <Setter Property="OffContent" Value="" />
    <Setter Property="Height" Value="24" />
  </Style>

  <!-- ========== HOTKEY RECORDER ========== -->

  <!-- Hotkey Recorder (uses code-behind class names) -->
  <Style Selector="Border.WizardHotkeyRecorder">
    <Setter Property="Background" Value="{DynamicResource WizSurface}" />
    <Setter Property="BorderBrush" Value="{DynamicResource WizBorder}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Height" Value="56" />
    <Setter Property="Padding" Value="16,0" />
  </Style>

  <Style Selector="Border.wiz-hotkey-recorder-recording">
    <Setter Property="BorderBrush" Value="{DynamicResource WizAccent}" />
    <Setter Property="BorderThickness" Value="2" />
  </Style>

  <Style Selector="Border.wiz-hotkey-recorder-conflict">
    <Setter Property="BorderBrush" Value="{DynamicResource WizDanger}" />
    <Setter Property="BorderThickness" Value="2" />
  </Style>

  <Style Selector="Border.wiz-hotkey-recorder-recorded">
    <Setter Property="BorderBrush" Value="{DynamicResource WizAccent}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>

  <!-- ========== CONFLICT / WARNING CARDS ========== -->

  <Style Selector="Border.WizardConflictCard">
    <Setter Property="Background" Value="{DynamicResource WizDangerSubtle}" />
    <Setter Property="BorderBrush" Value="{DynamicResource WizDanger}" />
    <Setter Property="BorderThickness" Value="0,0,0,3" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Padding" Value="16" />
  </Style>

  <Style Selector="Border.WizardWarningCard">
    <Setter Property="Background" Value="{DynamicResource WizWarningSubtle}" />
    <Setter Property="BorderBrush" Value="{DynamicResource WizWarning}" />
    <Setter Property="BorderThickness" Value="0,0,0,3" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Padding" Value="16" />
  </Style>

  <Style Selector="Border.WizardSuccessCard">
    <Setter Property="Background" Value="{DynamicResource WizSuccessSubtle}" />
    <Setter Property="BorderBrush" Value="{DynamicResource WizSuccess}" />
    <Setter Property="BorderThickness" Value="0,0,0,3" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Padding" Value="16" />
  </Style>

  <!-- ========== PROGRESS BAR ========== -->

  <Style Selector="ProgressBar.WizardProgressBar">
    <Setter Property="Height" Value="4" />
    <Setter Property="Minimum" Value="0" />
    <Setter Property="Maximum" Value="100" />
    <Setter Property="CornerRadius" Value="2" />
    <Setter Property="Background" Value="{DynamicResource WizBorder}" />
    <Setter Property="Foreground" Value="{DynamicResource WizAccent}" />
    <Setter Property="IsIndeterminate" Value="false" />
  </Style>

  <!-- ========== TYPOGRAPHY ========== -->

  <Style Selector="TextBlock.WizardStepTitle">
    <Setter Property="FontFamily" Value="{DynamicResource WizFontFamily}" />
    <Setter Property="FontSize" Value="18" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource WizTextPrimary}" />
  </Style>

  <Style Selector="TextBlock.WizardStepSubtitle">
    <Setter Property="FontFamily" Value="{DynamicResource WizFontFamily}" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="FontWeight" Value="Normal" />
    <Setter Property="Foreground" Value="{DynamicResource WizTextSecondary}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>

  <Style Selector="TextBlock.WizardPathPreview">
    <Setter Property="FontFamily" Value="{DynamicResource WizMonoFontFamily}" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Foreground" Value="{DynamicResource WizTextSecondary}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>

  <Style Selector="TextBlock.WizardError">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Foreground" Value="{DynamicResource WizDanger}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>

  <Style Selector="TextBlock.WizardHotkeyDisplay">
    <Setter Property="FontFamily" Value="{DynamicResource WizMonoFontFamily}" />
    <Setter Property="FontSize" Value="18" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource WizTextPrimary}" />
    <Setter Property="HorizontalAlignment" Value="Left" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <!-- ========== EXPANDER (Secondary hotkeys, etc.) ========== -->

  <Style Selector="Expander.WizardExpander">
    <Setter Property="Foreground" Value="{DynamicResource WizTextSecondary}" />
    <Setter Property="FontSize" Value="13" />
  </Style>

  <!-- ========== DIRECTORY PICKER ========== -->

  <Style Selector="Border.WizardDirectoryPicker">
    <Setter Property="Background" Value="{DynamicResource WizSurface}" />
    <Setter Property="BorderBrush" Value="{DynamicResource WizBorder}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Height" Value="48" />
  </Style>

  <!-- ========== LANGUAGE ROW (OCR) ========== -->

  <Style Selector="Border.WizardLanguageRow">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="{DynamicResource WizBorder}" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
    <Setter Property="Padding" Value="12,8" />
  </Style>

  <Style Selector="CheckBox.WizardLanguageCheckBox">
    <Setter Property="Foreground" Value="{DynamicResource WizTextPrimary}" />
    <Setter Property="FontSize" Value="14" />
  </Style>

</Styles>
