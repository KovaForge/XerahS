<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- ========== WINDOW STYLE ========== -->

  <Style Selector="Window#OnboardingWizardWindow">
    <Setter Property="Background" Value="{DynamicResource SolidBackgroundFillColorBaseBrush}" />
    <Setter Property="Width" Value="640" />
    <Setter Property="Height" Value="520" />
    <Setter Property="MinWidth" Value="480" />
    <Setter Property="MinHeight" Value="440" />
    <Setter Property="MaxWidth" Value="800" />
    <Setter Property="MaxHeight" Value="640" />
    <Setter Property="WindowStartupLocation" Value="CenterScreen" />
    <Setter Property="WindowDecorations" Value="Full" />
    <Setter Property="CanResize" Value="True" />
    <Setter Property="ShowInTaskbar" Value="True" />
    <Setter Property="Title" Value="Welcome to XerahS" />
  </Style>

  <!-- ========== WIZARD CARD ========== -->

  <Style Selector="Border.WizardCard">
    <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="12" />
    <Setter Property="Padding" Value="24" />
  </Style>

  <!-- ========== BUTTON STYLES ========== -->

  <!-- Primary button - uses accent solid -->
  <Style Selector="Button.WizardPrimaryButton">
    <Setter Property="Background" Value="{DynamicResource XerahS.Brush.Accent.Solid}" />
    <Setter Property="Foreground" Value="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Height" Value="40" />
    <Setter Property="Padding" Value="24,0" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>

  <Style Selector="Button.WizardPrimaryButton:pointerover">
    <Setter Property="Background" Value="{DynamicResource XerahS.Brush.Accent.SolidHover}" />
  </Style>

  <Style Selector="Button.WizardPrimaryButton:pressed">
    <Setter Property="Background" Value="{DynamicResource XerahS.Brush.Accent.SolidPressed}" />
  </Style>

  <Style Selector="Button.WizardPrimaryButton:disabled">
    <Setter Property="Opacity" Value="0.5" />
  </Style>

  <!-- Ghost/outline button -->
  <Style Selector="Button.WizardGhostButton">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Height" Value="40" />
    <Setter Property="Padding" Value="20,0" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>

  <Style Selector="Button.WizardGhostButton:pointerover">
    <Setter Property="Background" Value="{DynamicResource XerahS.Brush.Accent.Subtle}" />
    <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
  </Style>

  <Style Selector="Button.WizardGhostButton:pressed">
    <Setter Property="Background" Value="{DynamicResource XerahS.Brush.Accent.SubtlePressed}" />
  </Style>

  <!-- Skip link text button -->
  <Style Selector="Button.WizardSkipLink">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>

  <Style Selector="Button.WizardSkipLink:pointerover">
    <Setter Property="Foreground" Value="{DynamicResource AccentFillColorDefaultBrush}" />
  </Style>

  <!-- ========== PROGRESS DOTS ========== -->

  <!-- Base progress dot -->
  <Style Selector="Ellipse.WizardProgressDot">
    <Setter Property="Width" Value="24" />
    <Setter Property="Height" Value="24" />
    <Setter Property="StrokeThickness" Value="2" />
    <Setter Property="Stroke" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
    <Setter Property="Fill" Value="Transparent" />
  </Style>

  <!-- Current step dot (ring + pulse) -->
  <Style Selector="Ellipse.WizardProgressDotCurrent">
    <Setter Property="Stroke" Value="{DynamicResource AccentFillColorDefaultBrush}" />
    <Setter Property="StrokeThickness" Value="2.5" />
    <Setter Property="Fill" Value="Transparent" />
  </Style>

  <!-- Completed step dot (filled + checkmark) -->
  <Style Selector="Ellipse.WizardProgressDotCompleted">
    <Setter Property="Stroke" Value="{DynamicResource AccentFillColorDefaultBrush}" />
    <Setter Property="StrokeThickness" Value="0" />
    <Setter Property="Fill" Value="{DynamicResource AccentFillColorDefaultBrush}" />
  </Style>

  <!-- Future step dot -->
  <Style Selector="Ellipse.WizardProgressDotFuture">
    <Setter Property="Stroke" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
    <Setter Property="StrokeThickness" Value="2" />
    <Setter Property="Fill" Value="Transparent" />
  </Style>

  <!-- Connecting line between dots -->
  <Style Selector="Rectangle.WizardProgressLine">
    <Setter Property="Height" Value="2" />
    <Setter Property="Fill" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <Style Selector="Rectangle.WizardProgressLineCompleted">
    <Setter Property="Fill" Value="{DynamicResource AccentFillColorDefaultBrush}" />
  </Style>

  <!-- ========== RADIO CARDS ========== -->

  <!-- Radio card base -->
  <Style Selector="Border.WizardRadioCard">
    <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Padding" Value="12" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>

  <Style Selector="Border.WizardRadioCard:pointerover">
    <Setter Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
  </Style>

  <!-- Selected radio card -->
  <Style Selector="Border.WizardRadioCardSelected">
    <Setter Property="Background" Value="{DynamicResource AccentFillColorSecondaryBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
    <Setter Property="BorderThickness" Value="2" />
  </Style>

  <!-- RadioButton styling for cards -->
  <Style Selector="RadioButton.WizardRadioCardRadio">
    <Setter Property="Margin" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Background" Value="Transparent" />
  </Style>

  <!-- ========== INPUT STYLES ========== -->

  <!-- Base input style -->
  <Style Selector="TextBox.WizardInput">
    <Setter Property="Background" Value="{DynamicResource ControlFillColorDefaultBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Height" Value="40" />
    <Setter Property="Padding" Value="12,0" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
  </Style>

  <Style Selector="TextBox.WizardInput:pointerover">
    <Setter Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
  </Style>

  <Style Selector="TextBox.WizardInput:focus">
    <Setter Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
    <Setter Property="BorderThickness" Value="2" />
  </Style>

  <!-- ComboBox style -->
  <Style Selector="ComboBox.WizardComboBox">
    <Setter Property="Background" Value="{DynamicResource ControlFillColorDefaultBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Height" Value="40" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
  </Style>

  <Style Selector="ComboBox.WizardComboBox:pointerover">
    <Setter Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
  </Style>

  <!-- CheckBox style -->
  <Style Selector="CheckBox.WizardCheckBox">
    <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="Padding" Value="8,0" />
  </Style>

  <!-- Toggle switch -->
  <Style Selector="ToggleSwitch.WizardToggle">
    <Setter Property="OnContent" Value="" />
    <Setter Property="OffContent" Value="" />
    <Setter Property="Height" Value="24" />
  </Style>

  <!-- ========== HOTKEY RECORDER ========== -->

  <!-- Hotkey Recorder -->
  <Style Selector="Border.WizardHotkeyRecorder">
    <Setter Property="Background" Value="{DynamicResource ControlFillColorDefaultBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Height" Value="56" />
    <Setter Property="Padding" Value="16,0" />
  </Style>

  <Style Selector="Border.wiz-hotkey-recorder-recording">
    <Setter Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
    <Setter Property="BorderThickness" Value="2" />
  </Style>

  <Style Selector="Border.wiz-hotkey-recorder-conflict">
    <Setter Property="BorderBrush" Value="{DynamicResource StatusErrorBorderBrush}" />
    <Setter Property="BorderThickness" Value="2" />
  </Style>

  <Style Selector="Border.wiz-hotkey-recorder-recorded">
    <Setter Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>

  <!-- ========== CONFLICT / WARNING / SUCCESS CARDS ========== -->

  <Style Selector="Border.WizardConflictCard">
    <Setter Property="Background" Value="{DynamicResource StatusErrorFillBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource StatusErrorBorderBrush}" />
    <Setter Property="BorderThickness" Value="0,0,0,3" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Padding" Value="16" />
  </Style>

  <Style Selector="Border.WizardWarningCard">
    <Setter Property="Background" Value="{DynamicResource StatusWarningFillBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource StatusWarningBorderBrush}" />
    <Setter Property="BorderThickness" Value="0,0,0,3" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Padding" Value="16" />
  </Style>

  <Style Selector="Border.WizardSuccessCard">
    <Setter Property="Background" Value="{DynamicResource StatusSuccessFillBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource StatusSuccessBorderBrush}" />
    <Setter Property="BorderThickness" Value="0,0,0,3" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Padding" Value="16" />
  </Style>

  <!-- ========== PROGRESS BAR ========== -->

  <Style Selector="ProgressBar.WizardProgressBar">
    <Setter Property="Height" Value="4" />
    <Setter Property="Minimum" Value="0" />
    <Setter Property="Maximum" Value="100" />
    <Setter Property="CornerRadius" Value="2" />
    <Setter Property="Background" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource AccentFillColorDefaultBrush}" />
    <Setter Property="IsIndeterminate" Value="false" />
  </Style>

  <!-- ========== TYPOGRAPHY ========== -->

  <Style Selector="TextBlock.WizardStepTitle">
    <Setter Property="FontFamily" Value="{DynamicResource AppFontFamily}" />
    <Setter Property="FontSize" Value="18" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
  </Style>

  <Style Selector="TextBlock.WizardStepSubtitle">
    <Setter Property="FontFamily" Value="{DynamicResource AppFontFamily}" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="FontWeight" Value="Normal" />
    <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>

  <Style Selector="TextBlock.WizardPathPreview">
    <Setter Property="FontFamily" Value="JetBrains Mono, Consolas, monospace" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>

  <Style Selector="TextBlock.WizardError">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Foreground" Value="{DynamicResource StatusErrorForegroundBrush}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>

  <Style Selector="TextBlock.WizardHotkeyDisplay">
    <Setter Property="FontFamily" Value="JetBrains Mono, Consolas, monospace" />
    <Setter Property="FontSize" Value="18" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
    <Setter Property="HorizontalAlignment" Value="Left" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <!-- ========== EXPANDER (Secondary hotkeys, etc.) ========== -->

  <Style Selector="Expander.WizardExpander">
    <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
    <Setter Property="FontSize" Value="13" />
  </Style>

  <!-- ========== DIRECTORY PICKER ========== -->

  <Style Selector="Border.WizardDirectoryPicker">
    <Setter Property="Background" Value="{DynamicResource ControlFillColorDefaultBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Height" Value="40" />
  </Style>

  <!-- ========== LANGUAGE ROW (OCR) ========== -->

  <Style Selector="Border.WizardLanguageRow">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
    <Setter Property="Padding" Value="12,8" />
  </Style>

  <Style Selector="CheckBox.WizardLanguageCheckBox">
    <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
    <Setter Property="FontSize" Value="14" />
  </Style>

  <!-- ========== TOGGLE BUTTON (OCR language chips) ========== -->

  <Style Selector="ToggleButton.WizardLanguageChip">
    <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="Padding" Value="12,6" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>

  <Style Selector="ToggleButton.WizardLanguageChip:pointerover">
    <Setter Property="Background" Value="{DynamicResource AccentFillColorSecondaryBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
  </Style>

  <Style Selector="ToggleButton.WizardLanguageChip:checked">
    <Setter Property="Background" Value="{DynamicResource AccentFillColorSecondaryBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
    <Setter Property="BorderThickness" Value="2" />
    <Setter Property="Foreground" Value="{DynamicResource AccentFillColorDefaultBrush}" />
  </Style>

  <!-- ========== SECTION HEADERS ========== -->

  <Style Selector="TextBlock.WizardSectionHeader">
    <Setter Property="FontSize" Value="13" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
    <Setter Property="Margin" Value="0,0,0,8" />
  </Style>

  <Style Selector="TextBlock.WizardSectionHint">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
  </Style>

</Styles>
