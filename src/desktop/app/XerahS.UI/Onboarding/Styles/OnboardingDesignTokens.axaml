<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!--
    Onboarding Design Tokens
    These delegate to existing XerahS theme resources for consistency.
    The wizard uses the same visual language as the rest of the application.
  -->
  <Styles.Resources>
    <ResourceDictionary>
      <ResourceDictionary.ThemeDictionaries>

        <!-- Light Theme (default) - delegates to XerahS theme -->
        <ResourceDictionary x:Key="Light">
          <!-- All Wiz* brushes delegate to existing XerahS brushes -->
          <SolidColorBrush x:Key="WizBg" Color="{DynamicResource XerahS.Color.Surface.Window}" />
          <SolidColorBrush x:Key="WizSurface" Color="{DynamicResource XerahS.Color.Surface.Card}" />
          <SolidColorBrush x:Key="WizBorder" Color="{DynamicResource XerahS.Color.Stroke.Subtle}" />
          <SolidColorBrush x:Key="WizTextPrimary" Color="{DynamicResource XerahS.Color.Text.Primary}" />
          <SolidColorBrush x:Key="WizTextSecondary" Color="{DynamicResource XerahS.Color.Text.Secondary}" />
          <SolidColorBrush x:Key="WizAccent" Color="{DynamicResource SystemAccentColor}" />
          <SolidColorBrush x:Key="WizAccentHover" Color="{DynamicResource SystemAccentColor}" Opacity="0.85" />
          <SolidColorBrush x:Key="WizDanger" Color="{DynamicResource XerahS.Color.Status.Error.Border}" />
          <SolidColorBrush x:Key="WizWarning" Color="{DynamicResource XerahS.Color.Status.Warning.Border}" />
          <SolidColorBrush x:Key="WizSuccess" Color="{DynamicResource XerahS.Color.Status.Success.Border}" />
        </ResourceDictionary>

        <!-- Dark Theme - delegates to XerahS dark theme -->
        <ResourceDictionary x:Key="Dark">
          <SolidColorBrush x:Key="WizBg" Color="{DynamicResource XerahS.Color.Surface.Window}" />
          <SolidColorBrush x:Key="WizSurface" Color="{DynamicResource XerahS.Color.Surface.Card}" />
          <SolidColorBrush x:Key="WizBorder" Color="{DynamicResource XerahS.Color.Stroke.Subtle}" />
          <SolidColorBrush x:Key="WizTextPrimary" Color="{DynamicResource XerahS.Color.Text.Primary}" />
          <SolidColorBrush x:Key="WizTextSecondary" Color="{DynamicResource XerahS.Color.Text.Secondary}" />
          <SolidColorBrush x:Key="WizAccent" Color="{DynamicResource SystemAccentColor}" />
          <SolidColorBrush x:Key="WizAccentHover" Color="{DynamicResource SystemAccentColor}" Opacity="0.85" />
          <SolidColorBrush x:Key="WizDanger" Color="{DynamicResource XerahS.Color.Status.Error.Border}" />
          <SolidColorBrush x:Key="WizWarning" Color="{DynamicResource XerahS.Color.Status.Warning.Border}" />
          <SolidColorBrush x:Key="WizSuccess" Color="{DynamicResource XerahS.Color.Status.Success.Border}" />
        </ResourceDictionary>

      </ResourceDictionary.ThemeDictionaries>

      <!-- Derived brushes (subtle fills) -->
      <SolidColorBrush x:Key="WizAccentSubtle" Color="{DynamicResource SystemAccentColor}" Opacity="0.14" />
      <SolidColorBrush x:Key="WizAccentSubtleHover" Color="{DynamicResource SystemAccentColor}" Opacity="0.20" />
      <SolidColorBrush x:Key="WizDangerSubtle" Color="{DynamicResource XerahS.Color.Status.Error.Fill}" />
      <SolidColorBrush x:Key="WizWarningSubtle" Color="{DynamicResource XerahS.Color.Status.Warning.Fill}" />
      <SolidColorBrush x:Key="WizSuccessSubtle" Color="{DynamicResource XerahS.Color.Status.Success.Fill}" />

    </ResourceDictionary>
  </Styles.Resources>
</Styles>