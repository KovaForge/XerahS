<UserControl xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:XerahS.UI.ViewModels"
        x:Class="XerahS.UI.Views.Dialogs.OpenImageChoiceDialog"
        x:DataType="vm:OpenImageChoiceViewModel"
        MinWidth="420" MaxWidth="520">
    <Border Background="{DynamicResource SolidBackgroundFillColorSecondaryBrush}"
            Padding="16">
        <StackPanel Spacing="12">
            <TextBlock Text="An image is already open"
                       FontSize="16"
                       FontWeight="SemiBold"/>
            <TextBlock Text="Do you want to replace the current image or add the new image as a shape?"
                       TextWrapping="Wrap"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                <Button Content="Add as Shape" Command="{Binding AddAsShapeCommand}"/>
                <Button Content="Replace Image" Command="{Binding ReplaceCommand}" Classes="accent"/>
                <Button Content="Cancel" Command="{Binding CancelCommand}" IsCancel="True"/>
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>
