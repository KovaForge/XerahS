<ui:SurfaceWindow xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="using:XerahS.UI.Views"
        xmlns:vm="using:XerahS.UI.ViewModels"
        xmlns:plugins="using:XerahS.Uploaders.PluginSystem"
        x:Class="XerahS.UI.Views.PluginInstallerDialog"
        x:DataType="vm:PluginInstallerViewModel"
        Title="Install Plugin"
        Icon="/Assets/Logo.ico"
        Width="760" Height="760"
        CanResize="False"
        WindowStartupLocation="CenterOwner">

    <Grid Margin="24" RowDefinitions="Auto, *, Auto">

        <!-- Header -->
        <StackPanel Grid.Row="0" Spacing="4" Margin="0,0,0,20">
            <TextBlock Text="Install Plugin" Theme="{StaticResource TitleTextBlockStyle}"/>
            <TextBlock Text="Install community plugins from the registry, or import a local .xsdp package."
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                       TextWrapping="Wrap"/>
        </StackPanel>

        <!-- Main Content -->
        <ScrollViewer Grid.Row="1">
            <StackPanel Spacing="24">

                <!-- Community Registry -->
                <StackPanel Spacing="10">
                    <Grid ColumnDefinitions="*, Auto" ColumnSpacing="8">
                        <StackPanel Grid.Column="0" Spacing="4">
                            <TextBlock Text="Community Plugins" Theme="{StaticResource BodyStrongTextBlockStyle}"/>
                            <TextBlock Text="{Binding CommunityPluginSummary}" FontSize="12" Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                        </StackPanel>
                        <Button Grid.Column="1"
                                Content="Refresh"
                                Command="{Binding RefreshCommunityPluginsCommand}"
                                IsEnabled="{Binding CanRefreshCommunityPlugins}"
                                AutomationProperties.Name="Refresh Community Plugins"/>
                    </Grid>

                    <ProgressBar IsIndeterminate="True"
                                 IsVisible="{Binding IsLoadingCommunityPlugins}"
                                 Height="4"
                                 AutomationProperties.Name="Community Plugin Refresh Progress"/>

                    <Border Padding="12"
                            BorderThickness="1"
                            CornerRadius="4"
                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                            IsVisible="{Binding IsCommunityEmptyStateVisible}">
                        <TextBlock Text="No community plugins are available yet. Refresh checks the official registry for verified .xsdp packages."
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   TextWrapping="Wrap"/>
                    </Border>

                    <ListBox ItemsSource="{Binding CommunityPlugins}"
                             SelectedItem="{Binding SelectedCommunityPlugin}"
                             MinHeight="140"
                             MaxHeight="220"
                             IsVisible="{Binding HasCommunityPlugins}"
                             AutomationProperties.Name="Community Plugin List">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="plugins:CommunityPluginIndexEntry">
                                <Border Padding="8">
                                    <StackPanel Spacing="4">
                                        <Grid ColumnDefinitions="*, Auto" ColumnSpacing="8">
                                            <TextBlock Grid.Column="0" Text="{Binding Name}" Theme="{StaticResource BodyStrongTextBlockStyle}"/>
                                            <TextBlock Grid.Column="1" Text="{Binding CategorySummary}" FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                                        </Grid>
                                        <TextBlock Text="{Binding VersionAuthor}" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                        <TextBlock Text="{Binding Description}" TextWrapping="Wrap" MaxLines="2" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <Border Theme="{StaticResource CardBorderTheme}"
                            IsVisible="{Binding HasSelectedCommunityPlugin}">
                        <StackPanel Spacing="10">
                            <Grid ColumnDefinitions="*, Auto" ColumnSpacing="12">
                                <StackPanel Grid.Column="0" Spacing="3">
                                    <TextBlock Text="{Binding SelectedCommunityPlugin.Name}" Theme="{StaticResource SubtitleTextBlockStyle}"/>
                                    <TextBlock Text="{Binding SelectedCommunityPluginVersionAuthor}" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                </StackPanel>
                                <TextBlock Grid.Column="1"
                                           Text="{Binding SelectedCommunityPlugin.CategorySummary}"
                                           FontSize="12"
                                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                           VerticalAlignment="Center"/>
                            </Grid>

                            <TextBlock Text="{Binding SelectedCommunityPlugin.Description}"
                                       TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>

                            <Grid ColumnDefinitions="Auto, *" RowDefinitions="Auto, Auto, Auto" RowSpacing="4" ColumnSpacing="12">
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="ID:" Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                                <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding SelectedCommunityPlugin.PluginId}"/>

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Compatibility:" Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SelectedCommunityPluginCompatibility}" TextWrapping="Wrap"/>

                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Dependencies:" Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding SelectedCommunityPluginDependencies}" TextWrapping="Wrap"/>
                            </Grid>

                            <TextBlock Text="{Binding SelectedCommunityPluginInstallState}"
                                       TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>

                            <Button Content="Download and Install"
                                    Command="{Binding InstallCommunityPluginCommand}"
                                    IsEnabled="{Binding CanInstallCommunityPlugin}"
                                    Classes="accent"
                                    HorizontalAlignment="Left"
                                    AutomationProperties.Name="Install Community Plugin"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <Separator/>

                <!-- File Selection -->
                <StackPanel Spacing="8">
                    <TextBlock Text="Install Local Plugin Package (.xsdp)" Theme="{StaticResource BodyStrongTextBlockStyle}"/>
                    <Grid ColumnDefinitions="*, Auto" ColumnSpacing="8">
                        <TextBox Grid.Column="0"
                                 Text="{Binding PackageFilePath}"
                                 IsReadOnly="True"
                                 PlaceholderText="Select a .xsdp file..."
                                 AutomationProperties.Name="Plugin Package Path"/>
                        <Button Grid.Column="1"
                                Content="Browse"
                                Command="{Binding BrowsePackageCommand}"
                                AutomationProperties.Name="Browse Plugin Package"/>
                    </Grid>
                </StackPanel>

                <!-- Plugin Info Card -->
                <Border Theme="{StaticResource CardBorderTheme}"
                        IsVisible="{Binding Manifest, Converter={x:Static ObjectConverters.IsNotNull}}">
                    <StackPanel Spacing="12">
                        <Grid ColumnDefinitions="*, Auto">
                            <StackPanel Grid.Column="0" Spacing="4">
                                <TextBlock Text="{Binding Manifest.Name}" Theme="{StaticResource SubtitleTextBlockStyle}"/>
                                <TextBlock Text="{Binding ManifestVersionAuthor}" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                            </StackPanel>
                            <!-- Type/Category Badge could go here in future -->
                        </Grid>

                        <TextBlock Text="{Binding Manifest.Description}" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>

                        <Separator/>

                        <Grid ColumnDefinitions="Auto, *" RowDefinitions="Auto, Auto" RowSpacing="4" ColumnSpacing="12">
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="ID:" Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Manifest.PluginId}"/>

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="API:" Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Manifest.ApiVersion}"/>
                        </Grid>

                        <TextBlock Text="{Binding ManifestCategories}"  FontSize="12" Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                    </StackPanel>
                </Border>

                <!-- Status Message -->
                <Border Background="{DynamicResource SystemFillColorSuccessBackgroundBrush}"
                        BorderBrush="{DynamicResource SystemFillColorSuccessBrush}"
                        BorderThickness="1"
                        CornerRadius="4"
                        Padding="12"
                        IsVisible="{Binding StatusMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                    <TextBlock Text="{Binding StatusMessage}"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                               TextWrapping="Wrap"/>
                </Border>

                <!-- Error Message -->
                 <Border Background="{DynamicResource SystemFillColorCriticalBackgroundBrush}"
                        BorderBrush="{DynamicResource SystemFillColorCriticalBrush}"
                        BorderThickness="1"
                        CornerRadius="4"
                        Padding="12"
                        IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                    <TextBlock Text="{Binding ErrorMessage}"
                               Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                               TextWrapping="Wrap"/>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- Footer Actions -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="12" Margin="0,24,0,0">
            <Button Content="Install"
                    Command="{Binding InstallCommand}"
                    IsEnabled="{Binding CanInstall}"
                    Classes="accent"
                    AutomationProperties.Name="Install Plugin"/>
            <Button Content="Cancel"
                    Command="{Binding CancelCommand}"
                    AutomationProperties.Name="Cancel Installation"/>
        </StackPanel>

    </Grid>
</ui:SurfaceWindow>
