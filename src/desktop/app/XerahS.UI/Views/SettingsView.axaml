<views:PageView xmlns="https://github.com/avaloniaui"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                xmlns:views="using:XerahS.UI.Views"
                xmlns:vm="using:XerahS.UI.ViewModels"
                xmlns:search="using:XerahS.UI.Services.SettingsSearch"
                xmlns:common="clr-namespace:XerahS.Common;assembly=XerahS.Common"
                xmlns:theming="clr-namespace:XerahS.UI.Theming"
                mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="600"
                x:Class="XerahS.UI.Views.SettingsView"
                x:DataType="vm:SettingsSearchViewModel">

    <Design.DataContext>
        <vm:SettingsSearchViewModel/>
    </Design.DataContext>

    <Grid Margin="24"
          HorizontalAlignment="Stretch"
          VerticalAlignment="Stretch"
          RowDefinitions="Auto,Auto,*,Auto">
        <StackPanel Grid.Row="0" Spacing="8" Margin="0,0,0,16" HorizontalAlignment="Center" MaxWidth="560">
            <TextBlock Classes="IconGlyph"
                       FontSize="48"
                       HorizontalAlignment="Center"
                       Foreground="{DynamicResource AccentFillColorDefaultBrush}"
                       Text="{x:Static theming:HostIcons.NavigationSettings}"/>
            <TextBlock Text="{Binding Source={x:Static common:AppResources.AppName}, StringFormat='{}{0} Settings'}"
                       Theme="{StaticResource TitleTextBlockStyle}"
                       HorizontalAlignment="Center"/>
            <TextBlock Text="Search for a setting, then jump to Application or Destination Settings."
                       Theme="{StaticResource BodyTextBlockStyle}"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                       TextWrapping="Wrap"
                       HorizontalAlignment="Center"
                       TextAlignment="Center"/>
        </StackPanel>

        <Grid Grid.Row="1"
              ColumnDefinitions="*,Auto"
              MaxWidth="640"
              HorizontalAlignment="Stretch"
              Margin="0,0,0,12">
            <TextBox Grid.Column="0"
                     x:Name="SettingsSearchBox"
                     Text="{Binding SearchQuery, Mode=TwoWay}"
                     Watermark="Search settings (theme, tray, proxy, imgur…)"
                     MinHeight="36"
                     AutomationProperties.Name="Settings Search"/>
            <Button Grid.Column="1"
                    Margin="8,0,0,0"
                    Content="Clear"
                    Command="{Binding ClearSearchCommand}"
                    AutomationProperties.Name="Clear Settings Search"/>
        </Grid>

        <Border Grid.Row="2"
                MaxWidth="640"
                HorizontalAlignment="Stretch"
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="6"
                Padding="0">
            <Grid>
                <ListBox ItemsSource="{Binding Results}"
                         SelectedItem="{Binding SelectedResult}"
                         DoubleTapped="OnResultsDoubleTapped"
                         KeyDown="OnResultsKeyDown"
                         IsVisible="{Binding HasResults}"
                         Background="Transparent"
                         AutomationProperties.Name="Settings Search Results">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="search:SettingsSearchEntry">
                            <Grid ColumnDefinitions="*,Auto" Margin="8,6">
                                <StackPanel Grid.Column="0" Spacing="2">
                                    <TextBlock Text="{Binding Title}"
                                               FontWeight="SemiBold"
                                               TextWrapping="Wrap"/>
                                    <TextBlock Text="{Binding PathLabel}"
                                               FontSize="12"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                               TextWrapping="Wrap"/>
                                </StackPanel>
                                <TextBlock Grid.Column="1"
                                           Margin="12,0,0,0"
                                           VerticalAlignment="Center"
                                           FontSize="11"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           Text="{Binding AreaLabel}"/>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <TextBlock Margin="16"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           IsVisible="{Binding ShowEmptyState}"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           Text="No matching settings. Try another keyword, or open Application / Destination Settings from the sidebar."/>

                <TextBlock Margin="16"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           IsVisible="{Binding ShowIdleHint}"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           Text="Tip: type tray, proxy, watch, imgur, or any checkbox label from settings."/>

                <Button Margin="12"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Bottom"
                        Classes="accent"
                        Content="Open selected"
                        Command="{Binding OpenSelectedResultCommand}"
                        AutomationProperties.Name="Open Selected Settings Result"/>
            </Grid>
        </Border>

        <TextBlock Grid.Row="3"
                   Margin="0,12,0,0"
                   HorizontalAlignment="Center"
                   FontSize="12"
                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                   Text="{Binding StatusText}"/>
    </Grid>
</views:PageView>
