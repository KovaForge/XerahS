<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>XerahS.UI</RootNamespace>
    <IsWindowsUiBuild>false</IsWindowsUiBuild>
    <IsMacOSUiBuild>false</IsMacOSUiBuild>
    <IsLinuxUiBuild>false</IsLinuxUiBuild>
    <IsWindowsUiBuild Condition="$(RuntimeIdentifier.StartsWith('win')) Or ('$(OS)' == 'Windows_NT' And '$(RuntimeIdentifier)' == '' And '$(CrossCompile)' != 'true')">true</IsWindowsUiBuild>
    <IsMacOSUiBuild Condition="$(RuntimeIdentifier.StartsWith('osx')) Or ('$(RuntimeIdentifier)' == '' And $([MSBuild]::IsOSPlatform('OSX')))">true</IsMacOSUiBuild>
    <IsLinuxUiBuild Condition="$(RuntimeIdentifier.StartsWith('linux')) Or ('$(RuntimeIdentifier)' == '' And $([MSBuild]::IsOSPlatform('Linux')))">true</IsLinuxUiBuild>
    <TargetFramework>net10.0</TargetFramework>
    <TargetFramework Condition="'$(IsWindowsUiBuild)' == 'true'">net10.0-windows10.0.26100.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Controls.ColorPicker" />
    <PackageReference Include="Avalonia.Controls.DataGrid" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="Avalonia.Fonts.Inter" />
    <PackageReference Include="AvaloniaUI.DiagnosticsSupport" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="SkiaSharp" />

  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\core\XerahS.Core\XerahS.Core.csproj" />
    <ProjectReference Include="..\..\core\XerahS.Common\XerahS.Common.csproj" />
    <ProjectReference Include="..\..\core\XerahS.Media\XerahS.Media.csproj" />
    <ProjectReference Include="..\XerahS.Bootstrap\XerahS.Bootstrap.csproj" />
    <ProjectReference Include="..\..\..\platform\XerahS.Platform.Abstractions\XerahS.Platform.Abstractions.csproj" />
    <ProjectReference Include="..\..\core\XerahS.Indexer\XerahS.Indexer.csproj" />
    <ProjectReference Include="..\..\..\platform\XerahS.Platform.Windows\XerahS.Platform.Windows.csproj" Condition="'$(IsWindowsUiBuild)' == 'true'" />
    <ProjectReference Include="..\..\..\platform\XerahS.Platform.MacOS\XerahS.Platform.MacOS.csproj" Condition="'$(IsMacOSUiBuild)' == 'true'" />
    <ProjectReference Include="..\..\..\platform\XerahS.Platform.Linux\XerahS.Platform.Linux.csproj" Condition="'$(IsLinuxUiBuild)' == 'true'" />
    <ProjectReference Include="..\..\core\XerahS.Services.Abstractions\XerahS.Services.Abstractions.csproj" />
    <ProjectReference Include="..\XerahS.RegionCapture\XerahS.RegionCapture.csproj" />
    <ProjectReference Include="..\..\..\..\ShareX.ImageEditor\src\ShareX.ImageEditor\ShareX.ImageEditor.csproj" GlobalPropertiesToRemove="OS;Platform" />
    <ProjectReference Include="..\..\..\..\ShareX.VideoEditor\backend\ShareX.VideoEditor.csproj" GlobalPropertiesToRemove="Platform" />
  </ItemGroup>
  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
    <AvaloniaResource Remove="_Onboarding_DISABLED_\**" />
    <Compile Remove="_Onboarding_DISABLED_\**" />
    <EmbeddedResource Remove="_Onboarding_DISABLED_\**" />
    <None Remove="_Onboarding_DISABLED_\**" />
  </ItemGroup>
</Project>

