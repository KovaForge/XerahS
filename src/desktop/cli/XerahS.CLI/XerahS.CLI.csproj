<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>XerahS.CLI</RootNamespace>
    <RepoRoot>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\..\..\..'))\</RepoRoot>
    <IsWindowsCliBuild>false</IsWindowsCliBuild>
    <IsMacOSCliBuild>false</IsMacOSCliBuild>
    <IsLinuxCliBuild>false</IsLinuxCliBuild>
    <IsWindowsCliBuild Condition="$(RuntimeIdentifier.StartsWith('win')) Or ('$(OS)' == 'Windows_NT' And '$(RuntimeIdentifier)' == '')">true</IsWindowsCliBuild>
    <IsMacOSCliBuild Condition="$(RuntimeIdentifier.StartsWith('osx')) Or ('$(RuntimeIdentifier)' == '' And $([MSBuild]::IsOSPlatform('OSX')))">true</IsMacOSCliBuild>
    <IsLinuxCliBuild Condition="$(RuntimeIdentifier.StartsWith('linux')) Or ('$(RuntimeIdentifier)' == '' And $([MSBuild]::IsOSPlatform('Linux')))">true</IsLinuxCliBuild>
    <TargetFramework>net10.0</TargetFramework>
    <TargetFramework Condition="'$(IsWindowsCliBuild)' == 'true'">net10.0-windows10.0.26100.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <AssemblyName>xerahs</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <DefineConstants Condition="'$(IsWindowsCliBuild)' == 'true'">$(DefineConstants);WINDOWS</DefineConstants>
    <DefineConstants Condition="'$(IsMacOSCliBuild)' == 'true'">$(DefineConstants);MACOS</DefineConstants>
    <DefineConstants Condition="'$(IsLinuxCliBuild)' == 'true'">$(DefineConstants);LINUX</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="System.CommandLine" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\app\XerahS.Bootstrap\XerahS.Bootstrap.csproj"
                      Condition="$(RuntimeIdentifier.StartsWith('win')) Or ('$(OS)' == 'Windows_NT' And '$(RuntimeIdentifier)' == '')"
                      AdditionalProperties="RuntimeIdentifier=$(RuntimeIdentifier);CrossCompile=$(CrossCompile)" />
    <ProjectReference Include="..\..\app\XerahS.Bootstrap\XerahS.Bootstrap.csproj"
                      Condition="!($(RuntimeIdentifier.StartsWith('win')) Or ('$(OS)' == 'Windows_NT' And '$(RuntimeIdentifier)' == ''))"
                      GlobalPropertiesToRemove="OS"
                      AdditionalProperties="RuntimeIdentifier=$(RuntimeIdentifier);CrossCompile=$(CrossCompile)" />
    <ProjectReference Include="..\..\tools\XerahS.WatchFolder.Daemon\XerahS.WatchFolder.Daemon.csproj"
                      ReferenceOutputAssembly="false"
                      SkipGetTargetFrameworkProperties="true"
                      AdditionalProperties="RuntimeIdentifier=$(RuntimeIdentifier);CrossCompile=$(CrossCompile)" />
    <ProjectReference Include="..\..\core\XerahS.Core\XerahS.Core.csproj" />
    <ProjectReference Include="..\..\app\XerahS.RegionCapture\XerahS.RegionCapture.csproj" />
    <ProjectReference Include="..\..\..\..\ShareX.VideoEditor\backend\ShareX.VideoEditor.csproj"
                      GlobalPropertiesToRemove="Platform"
                      AdditionalProperties="BuildWebUI=false" />
    <ProjectReference Include="..\..\..\platform\XerahS.Platform.Abstractions\XerahS.Platform.Abstractions.csproj" />
    <ProjectReference Include="..\..\..\platform\XerahS.Platform.Windows\XerahS.Platform.Windows.csproj" Condition="'$(IsWindowsCliBuild)' == 'true'" />
    <ProjectReference Include="..\..\..\platform\XerahS.Platform.MacOS\XerahS.Platform.MacOS.csproj" Condition="'$(IsMacOSCliBuild)' == 'true'" />
    <ProjectReference Include="..\..\..\platform\XerahS.Platform.Linux\XerahS.Platform.Linux.csproj" Condition="'$(IsLinuxCliBuild)' == 'true'" />
  </ItemGroup>

  <ItemGroup Condition="$([MSBuild]::IsOSPlatform('OSX'))">
    <Content Include="$(RepoRoot)native/macos/libscreencapturekit_bridge.dylib">
      <Link>libscreencapturekit_bridge.dylib</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <!-- Auto-discover all plugin csproj files under src/desktop/plugins/*/ -->
  <PropertyGroup>
    <EnableAppDrivenPluginBuild Condition="'$(EnableAppDrivenPluginBuild)' == '' And '$(BuildingSolutionFile)' == 'true'">false</EnableAppDrivenPluginBuild>
    <EnableAppDrivenPluginBuild Condition="'$(EnableAppDrivenPluginBuild)' == ''">true</EnableAppDrivenPluginBuild>
  </PropertyGroup>
  <ItemGroup>
    <_DiscoveredPluginProjects Include="$(RepoRoot)src\desktop\plugins\*\*.csproj" />
  </ItemGroup>

  <Target Name="BuildPlugins" AfterTargets="Build" Condition="'$(SkipBundlePlugins)' != 'true' And '$(EnableAppDrivenPluginBuild)' == 'true'">
    <Message Text="[CLI Plugins] Auto-building discovered plugins: @(_DiscoveredPluginProjects->'%(Filename)', ', ')" Importance="High" />
    <MSBuild Projects="@(_DiscoveredPluginProjects)" Targets="Restore;Build" Properties="Configuration=$(Configuration);Platform=$(Platform);RuntimeIdentifier=$(RuntimeIdentifier);HostTargetFramework=$(TargetFramework)" />
  </Target>

  <Target Name="CopyPluginsToOutput" AfterTargets="BuildPlugins" Condition="'$(SkipBundlePlugins)' != 'true' And '$(EnableAppDrivenPluginBuild)' == 'true'">
    <Message Text="[CLI Plugins] Copying built plugins to CLI output..." Importance="High" />
    <ItemGroup>
      <_PluginFilesToCopy Include="$(RepoRoot)src\desktop\plugins\AmazonS3.Plugin\bin\$(Configuration)\$(TargetFramework)\*.dll" />
      <_PluginFilesToCopy Include="$(RepoRoot)src\desktop\plugins\AmazonS3.Plugin\bin\$(Configuration)\$(TargetFramework)\plugin.json" />
    </ItemGroup>
    <Copy SourceFiles="@(_PluginFilesToCopy)" DestinationFolder="$(OutDir)Plugins\amazons3" Condition="'@(_PluginFilesToCopy)' != ''" />
  </Target>

  <Target Name="BuildWatchFolderDaemonForDev" AfterTargets="Build">
    <Message Text="Copying watch folder daemon artifacts to CLI output..." Importance="High" />

    <PropertyGroup>
      <_WatchFolderDaemonBuildDir>$(MSBuildThisFileDirectory)..\..\tools\XerahS.WatchFolder.Daemon\bin\$(Configuration)\$(TargetFramework)\</_WatchFolderDaemonBuildDir>
      <_WatchFolderDaemonBuildDir Condition="'$(RuntimeIdentifier)' != ''">$(_WatchFolderDaemonBuildDir)$(RuntimeIdentifier)\</_WatchFolderDaemonBuildDir>
    </PropertyGroup>

    <ItemGroup>
      <_WatchFolderDaemonBuildFiles Include="$(_WatchFolderDaemonBuildDir)**\*.*"
                                    Exclude="$(_WatchFolderDaemonBuildDir)**\*.pdb;$(_WatchFolderDaemonBuildDir)**\*.xml" />
    </ItemGroup>

    <Copy SourceFiles="@(_WatchFolderDaemonBuildFiles)"
          DestinationFiles="@(_WatchFolderDaemonBuildFiles->'$(OutDir)%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true"
          Condition="'@(_WatchFolderDaemonBuildFiles)' != ''" />
  </Target>

  <Target Name="CopyVideoEditorWebUiForDev" AfterTargets="Build">
    <PropertyGroup>
      <_VideoEditorWebUiDistDir>$(RepoRoot)ShareX.VideoEditor\frontend\dist\</_VideoEditorWebUiDistDir>
    </PropertyGroup>

    <ItemGroup>
      <_VideoEditorWebUiBuildFiles Include="$(_VideoEditorWebUiDistDir)**\*" />
    </ItemGroup>

    <Error Condition="'@(_VideoEditorWebUiBuildFiles)' == ''"
           Text="Missing ShareX.VideoEditor frontend build output: $(_VideoEditorWebUiDistDir)" />

    <Copy SourceFiles="@(_VideoEditorWebUiBuildFiles)"
          DestinationFiles="@(_VideoEditorWebUiBuildFiles->'$(OutDir)frontend\dist\%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
  </Target>

  <Target Name="CopyVideoEditorWebUiForPublish" AfterTargets="Publish">
    <PropertyGroup>
      <_VideoEditorWebUiDistDir>$(RepoRoot)ShareX.VideoEditor\frontend\dist\</_VideoEditorWebUiDistDir>
    </PropertyGroup>

    <ItemGroup>
      <_VideoEditorWebUiPublishFiles Include="$(_VideoEditorWebUiDistDir)**\*" />
    </ItemGroup>

    <Error Condition="'@(_VideoEditorWebUiPublishFiles)' == ''"
           Text="Missing ShareX.VideoEditor frontend build output: $(_VideoEditorWebUiDistDir)" />

    <Copy SourceFiles="@(_VideoEditorWebUiPublishFiles)"
          DestinationFiles="@(_VideoEditorWebUiPublishFiles->'$(PublishDir)frontend\dist\%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
  </Target>

  <Target Name="RemoveTransitiveVideoEditorWebUiPublishItems" BeforeTargets="_HandleFileConflictsForPublish">
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)"
                             Condition="'%(ResolvedFileToPublish.RelativePath)' != '' and $([System.String]::Copy('%(ResolvedFileToPublish.RelativePath)').Replace('\','/').StartsWith('frontend/dist/'))" />
    </ItemGroup>
  </Target>
</Project>

