<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ShareX.Immich.Plugin.ViewModels"
             x:Class="ShareX.Immich.Plugin.Views.ImmichConfigView"
             x:DataType="vm:ImmichConfigViewModel">

    <StackPanel Spacing="14">
        <TextBlock Text="Immich Uploader"
                   FontSize="18"
                   FontWeight="SemiBold"
                   Margin="0,0,0,8"/>

        <TextBlock Text="This scaffold gives you a working config view, secret-store wiring, and provider shape. Replace the generic fields with service-specific settings."
                   TextWrapping="Wrap"
                   Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"/>

        <StackPanel Spacing="5">
            <TextBlock Text="Base URL *" FontWeight="Medium"/>
            <TextBox Text="{Binding BaseUrl, UpdateSourceTrigger=PropertyChanged}"
                     Watermark="https://api.example.com"/>
        </StackPanel>

        <StackPanel Spacing="5">
            <TextBlock Text="Upload Path" FontWeight="Medium"/>
            <TextBox Text="{Binding UploadPath, UpdateSourceTrigger=PropertyChanged}"
                     Watermark="uploads/%y/%mo"/>
        </StackPanel>

        <CheckBox Content="Create shareable link after upload"
                  IsChecked="{Binding CreateShareableLink}"/>

        <StackPanel Spacing="5">
            <TextBlock Text="API Token *" FontWeight="Medium"/>
            <TextBox Text="{Binding ApiToken, UpdateSourceTrigger=PropertyChanged}"
                     PasswordChar="*"
                     Watermark="Stored in the secret store"/>
        </StackPanel>

        <Border Background="{DynamicResource SystemFillColorAttentionBackground}"
                Padding="10"
                CornerRadius="4"
                IsVisible="{Binding !!StatusMessage}">
            <TextBlock Text="{Binding StatusMessage}"
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource SystemFillColorAttention}"/>
        </Border>
    </StackPanel>
</UserControl>
