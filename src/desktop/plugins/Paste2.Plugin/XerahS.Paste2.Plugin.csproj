<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- Must stay aligned with the ShareX.* namespaces in code. Avalonia compiled XAML resolves plugin views against RootNamespace, and changing this to XerahS.* breaks config views at runtime. -->
    <RootNamespace>ShareX.Paste2.Plugin</RootNamespace>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Library</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <EnableDynamicLoading>true</EnableDynamicLoading>
  </PropertyGroup>

  <PropertyGroup>
    <PluginId>paste2</PluginId>
    <PluginName>Paste2 Text Uploader</PluginName>
  </PropertyGroup>

  <!-- Avalonia packages for UI - use exact versions from main app -->
  <!-- Mark as ExcludeAssets=runtime so they are NOT copied to plugin output (use host's versions) -->
  <ItemGroup>
    <PackageReference Include="Avalonia">
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
    <PackageReference Include="Avalonia.Themes.Fluent">
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
    <PackageReference Include="CommunityToolkit.Mvvm">
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
    <PackageReference Include="Newtonsoft.Json">
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\core\XerahS.Uploaders\XerahS.Uploaders.csproj">
      <Private>false</Private>
      <ExcludeAssets>runtime</ExcludeAssets>
    </ProjectReference>
  </ItemGroup>

  <ItemGroup>
    <None Include="plugin.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
