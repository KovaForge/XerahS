<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:XerahS.UI.Onboarding.ViewModels.Steps"
             xmlns:converters="using:XerahS.UI.Converters"
             mc:Ignorable="d"
             x:Class="XerahS.UI.Onboarding.Steps.OcrStepView"
             d:DesignWidth="560"
             d:DesignHeight="440"
             x:DataType="vm:OcrStepViewModel">

  <StackPanel Spacing="0">
    <StackPanel Orientation="Horizontal" Spacing="16" Margin="0,0,0,32">
      <TextBlock Text="📝" FontSize="32" VerticalAlignment="Center" />
      <StackPanel VerticalAlignment="Center">
        <TextBlock Text="Text Recognition (OCR)" />
        <TextBlock Text="Select languages for text extraction" />
      </StackPanel>
    </StackPanel>

    <Border Margin="0,0,0,16" Padding="12,10" CornerRadius="6"
            Background="{DynamicResource XerahS.Onboarding.Brush.Background}">
      <TextBlock Text="You'll be able to extract text from screenshots using your hotkey + T"
                 FontFamily="DM Sans, system-ui" FontSize="12"
                 Foreground="{DynamicResource XerahS.Onboarding.Brush.Text.Secondary}"
                 TextWrapping="Wrap" />
    </Border>

    <Border MaxHeight="220" CornerRadius="8"
            BorderBrush="{DynamicResource XerahS.Onboarding.Brush.Border}" BorderThickness="1">
      <ScrollViewer>
        <ItemsControl ItemsSource="{Binding AvailableLanguages}" Padding="4">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:OcrLanguageOption">
              <Grid ColumnDefinitions="Auto,*,Auto" Margin="8,6" MinHeight="36">
                <CheckBox Grid.Column="0"
                          IsChecked="False"
                          Margin="0,0,12,0" VerticalAlignment="Center"
                          Click="OnLanguageCheckClicked" Tag="{Binding LanguageTag}" />
                <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                  <TextBlock Text="{Binding DisplayName}"
                             FontFamily="DM Sans, system-ui" FontSize="14"
                             Foreground="{DynamicResource XerahS.Onboarding.Brush.Text.Primary}" />
                  <TextBlock Text="{Binding NativeName}"
                             FontFamily="DM Sans, system-ui" FontSize="11"
                             Foreground="{DynamicResource XerahS.Onboarding.Brush.Text.Secondary}" />
                </StackPanel>
                <TextBlock Grid.Column="2"
                           Text="{Binding DownloadSizeMb, StringFormat='~{0} MB'}"
                           FontFamily="JetBrains Mono, monospace" FontSize="12"
                           Foreground="{DynamicResource XerahS.Onboarding.Brush.Text.Secondary}"
                           VerticalAlignment="Center" />
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
    </Border>

    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,12,0,0">
      <TextBlock Text="Total size:" FontFamily="DM Sans, system-ui" FontSize="13"
                 Foreground="{DynamicResource XerahS.Onboarding.Brush.Text.Secondary}"
                 VerticalAlignment="Center" />
      <TextBlock Text="{Binding TotalDownloadSizeMb, StringFormat='~{0} MB'}"
                 FontFamily="JetBrains Mono, monospace" FontSize="13" FontWeight="SemiBold"
                 Foreground="{DynamicResource XerahS.Onboarding.Brush.Text.Primary}"
                 VerticalAlignment="Center" />
    </StackPanel>

    <Border Margin="0,12,0,0" IsVisible="{Binding ExceedsRecommendedSize}">
      <StackPanel Orientation="Horizontal" Spacing="8">
        <TextBlock Text="⚠" FontSize="14" VerticalAlignment="Center"
                   Foreground="{DynamicResource XerahS.Onboarding.Brush.Warning}" />
        <TextBlock Text="Total exceeds 200 MB — consider deselecting some languages"
                   FontFamily="DM Sans, system-ui" FontSize="13"
                   Foreground="{DynamicResource XerahS.Onboarding.Brush.Warning}"
                   TextWrapping="Wrap" />
      </StackPanel>
    </Border>

    <CheckBox Content="Download in background"
              IsChecked="{Binding DownloadInBackground}" Margin="0,16,0,0" />
  </StackPanel>

</UserControl>
