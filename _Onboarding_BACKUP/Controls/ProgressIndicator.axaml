<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="using:XerahS.UI.Onboarding.Controls"
             mc:Ignorable="d" d:DesignWidth="560" d:DesignHeight="64"
             x:Class="XerahS.UI.Onboarding.Controls.ProgressIndicator"
             x:DataType="local:ProgressIndicator">
  <UserControl.Styles>
    <StyleInclude Source="/Onboarding/Styles/OnboardingStyles.axaml" />
  </UserControl.Styles>

  <LayoutTransformControl>
    <StackPanel Orientation="Horizontal"
                HorizontalAlignment="Center"
                Spacing="0">

      <!-- Step dots with connecting lines -->
      <ItemsControl x:Name="StepItemsControl"
                    ItemsSource="{Binding StepItems, RelativeSource={RelativeSource AncestorType=local:ProgressIndicator}}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <StackPanel Orientation="Horizontal" Spacing="0" />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="local:StepItem">
            <!-- Dot container -->
            <Grid x:Name="DotGrid" Width="32" Height="48" VerticalAlignment="Center">
              <!-- Circle indicator -->
              <Ellipse x:Name="DotCircle"
                       Width="24" Height="24"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center" />

              <!-- Step number text for future steps -->
              <TextBlock x:Name="StepNumberText"
                         Text="{Binding StepNumber}"
                         HorizontalAlignment="Center"
                         VerticalAlignment="Center"
                         FontSize="11"
                         FontWeight="SemiBold"
                         Foreground="{DynamicResource WizTextSecondary}" />
            </Grid>

            <!-- Connecting line (not after last dot) -->
            <StackPanel Orientation="Horizontal" Spacing="0" x:Name="ConnectorPanel"
                        IsVisible="{Binding HasNext}">
              <Rectangle x:Name="ConnectorLine"
                          Width="24"
                          Height="2"
                          VerticalAlignment="Center" />
            </StackPanel>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

    </StackPanel>
  </LayoutTransformControl>
</UserControl>
