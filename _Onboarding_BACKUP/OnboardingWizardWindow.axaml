<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:XerahS.UI.Onboarding"
        xmlns:steps="using:XerahS.UI.Onboarding.ViewModels.Steps"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="640" d:DesignHeight="520"
        x:Class="XerahS.UI.Onboarding.OnboardingWizardWindow"
        x:DataType="vm:OnboardingWizardViewModel"
        Title="Welcome to XerahS"
        Width="640"
        Height="520"
        MinWidth="480"
        MinHeight="440"
        MaxWidth="800"
        MaxHeight="640"
        WindowStartupLocation="CenterScreen"
        SizeToContent="Manual"
        SystemDecorations="Full"
        CanResize="True">

  <Design.DataContext>
    <vm:OnboardingWizardViewModel/>
  </Design.DataContext>

  <Grid RowDefinitions="Auto,Auto,*,Auto,Auto" Margin="24">

    <!-- Close Button (top-right) -->
    <Button Grid.Row="0"
            HorizontalAlignment="Right"
            VerticalAlignment="Top"
            Command="{Binding SkipAllCommand}"
            Content="✕"
            ToolTip.Tip="Skip wizard"
            Padding="8,4"
            Background="Transparent"
            BorderThickness="0"/>

    <!-- Step Indicator -->
    <StackPanel Grid.Row="1"
                Orientation="Horizontal"
                HorizontalAlignment="Center"
                Margin="0,0,0,16"
                Spacing="4">
      <ItemsControl ItemsSource="{Binding Steps}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <StackPanel Orientation="Horizontal" Spacing="4"/>
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate DataType="vm:StepViewModelBase">
            <StackPanel Orientation="Horizontal" Spacing="4">
              <TextBlock Text="●"
                         Foreground="{Binding StepIndex, Converter={StaticResource StepIndexToBrushConverter}, ConverterParameter={Binding $parent[ItemsControl].((vm:OnboardingWizardViewModel)DataContext).CurrentStepIndex}}"/>
              <TextBlock Text="───"
                         IsVisible="{Binding StepIndex, Converter={StaticResource LessThanConverter}, ConverterParameter={Binding $parent[ItemsControl].Items.Count, Converter={StaticResource SubtractOneConverter}}}"
                         Foreground="{DynamicResource ButtonBorderBrush}"/>
            </StackPanel>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>

    <!-- Content Area -->
    <Border Grid.Row="2"
            Background="{DynamicResource CardBackgroundBrush}"
            CornerRadius="8"
            Padding="24"
            Margin="0,0,0,16">
      <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="16">
          <!-- Step Header -->
          <StackPanel Spacing="4">
            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
              <TextBlock Text="🚀"
                         FontSize="24"
                         IsVisible="{Binding CurrentStepIndex, Converter={StaticResource EqualsConverter}, ConverterParameter=0}"/>
              <TextBlock Text="💾"
                         FontSize="24"
                         IsVisible="{Binding CurrentStepIndex, Converter={StaticResource EqualsConverter}, ConverterParameter=1}"/>
              <TextBlock Text="⌨️"
                         FontSize="24"
                         IsVisible="{Binding CurrentStepIndex, Converter={StaticResource EqualsConverter}, ConverterParameter=2}"/>
              <TextBlock Text="☁️"
                         FontSize="24"
                         IsVisible="{Binding CurrentStepIndex, Converter={StaticResource EqualsConverter}, ConverterParameter=3}"/>
              <TextBlock Text="🔤"
                         FontSize="24"
                         IsVisible="{Binding CurrentStepIndex, Converter={StaticResource EqualsConverter}, ConverterParameter=4}"/>
              <TextBlock Text="✨"
                         FontSize="24"
                         IsVisible="{Binding CurrentStepIndex, Converter={StaticResource EqualsConverter}, ConverterParameter=5}"/>
              <TextBlock Text="{Binding CurrentStep.StepTitle}"
                         FontSize="20"
                         FontWeight="SemiBold"/>
            </StackPanel>
            <TextBlock Text="{Binding CurrentStep.StepSubtitle}"
                       FontSize="14"
                       Opacity="0.8"/>
            <TextBlock Text="{Binding CurrentStep.StepDescription}"
                       FontSize="12"
                       Opacity="0.6"
                       TextWrapping="Wrap"/>
          </StackPanel>

          <!-- Validation Error -->
          <Border Background="{DynamicResource ErrorBrush}"
                  Opacity="0.1"
                  CornerRadius="4"
                  Padding="12"
                  IsVisible="{Binding CurrentStep.ValidationError, Converter={StaticResource StringNotEmptyConverter}}">
            <TextBlock Text="{Binding CurrentStep.ValidationError}"
                       Foreground="{DynamicResource ErrorBrush}"
                       TextWrapping="Wrap"/>
          </Border>

          <!-- Step Content -->
          <ContentControl Content="{Binding CurrentStep}">
            <ContentControl.DataTemplates>
              <!-- Welcome Step -->
              <DataTemplate DataType="steps:WelcomeStepViewModel">
                <StackPanel Spacing="16">
                  <TextBlock Text="Select your language:"
                             FontWeight="Medium"/>
                  <ComboBox ItemsSource="{Binding AvailableLanguages}"
                            SelectedValue="{Binding SelectedLanguage}"
                            SelectedValueBinding="{Binding Code}"
                            Width="300"
                            HorizontalAlignment="Left">
                    <ComboBox.ItemTemplate>
                      <DataTemplate>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                          <TextBlock Text="{Binding DisplayName}"/>
                          <TextBlock Text="-" Opacity="0.5"/>
                          <TextBlock Text="{Binding NativeName}" Opacity="0.7"/>
                        </StackPanel>
                      </DataTemplate>
                    </ComboBox.ItemTemplate>
                  </ComboBox>
                  <TextBlock Text="{Binding FallbackHint}"
                             IsVisible="{Binding FallbackHint, Converter={StaticResource StringNotEmptyConverter}}"
                             Foreground="{DynamicResource WarningBrush}"
                             FontSize="12"
                             TextWrapping="Wrap"/>
                </StackPanel>
              </DataTemplate>

              <!-- Save Location Step -->
              <DataTemplate DataType="steps:SaveLocationStepViewModel">
                <StackPanel Spacing="16">
                  <TextBlock Text="Where should screenshots be saved?"
                             FontWeight="Medium"/>

                  <!-- Quick Select -->
                  <StackPanel Spacing="8">
                    <TextBlock Text="Quick select:" FontSize="12" Opacity="0.7"/>
                    <ItemsControl ItemsSource="{Binding QuickSelectPaths}">
                      <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                          <WrapPanel/>
                        </ItemsPanelTemplate>
                      </ItemsControl.ItemsPanel>
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <Button Content="{Binding Name}"
                                  Command="{Binding $parent[ItemsControl].((steps:SaveLocationStepViewModel)DataContext).SelectPresetCommand}"
                                  CommandParameter="{Binding}"
                                  Margin="4"
                                  Padding="8,4"/>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>

                  <!-- Path Input -->
                  <StackPanel Spacing="8">
                    <TextBlock Text="Folder path:" FontSize="12" Opacity="0.7"/>
                    <Grid ColumnDefinitions="*,Auto">
                      <TextBox Grid.Column="0"
                               Text="{Binding SelectedPath}"
                               Watermark="Select a folder..."/>
                      <Button Grid.Column="1"
                              Content="Browse..."
                              Command="{Binding BrowseCommand}"
                              Margin="8,0,0,0"/>
                    </Grid>
                  </StackPanel>

                  <!-- Preview -->
                  <StackPanel Spacing="4">
                    <TextBlock Text="Preview:" FontSize="12" Opacity="0.7"/>
                    <TextBlock Text="{Binding PathPreview}"
                               FontFamily="{StaticResource MonospaceFontFamily}"
                               Opacity="0.6"
                               TextTrimming="CharacterEllipsis"/>
                  </StackPanel>

                  <!-- Options -->
                  <CheckBox Content="Create date subfolders"
                            IsChecked="{Binding CreateDateSubfolders}"/>

                  <!-- Error -->
                  <TextBlock Text="{Binding PathError}"
                             IsVisible="{Binding PathError, Converter={StaticResource StringNotEmptyConverter}}"
                             Foreground="{DynamicResource ErrorBrush}"
                             FontSize="12"/>
                </StackPanel>
              </DataTemplate>

              <!-- Hotkey Step -->
              <DataTemplate DataType="steps:HotkeyStepViewModel">
                <StackPanel Spacing="16">
                  <TextBlock Text="Primary capture hotkey:"
                             FontWeight="Medium"/>

                  <!-- Primary Hotkey Display -->
                  <Border Background="{DynamicResource ControlBackgroundBrush}"
                          CornerRadius="4"
                          Padding="16"
                          HorizontalAlignment="Left">
                    <TextBlock Text="{Binding PrimaryHotkey}"
                               FontSize="18"
                               FontFamily="{StaticResource MonospaceFontFamily}"/>
                  </Border>

                  <!-- Conflict Warning -->
                  <Border Background="{DynamicResource WarningBrush}"
                          Opacity="0.1"
                          CornerRadius="4"
                          Padding="12"
                          IsVisible="{Binding HasConflict}">
                    <TextBlock Text="{Binding ConflictMessage}"
                               Foreground="{DynamicResource WarningBrush}"
                               TextWrapping="Wrap"/>
                  </Border>

                  <!-- Secondary Hotkeys -->
                  <Expander Header="Additional hotkeys"
                            IsExpanded="False">
                    <StackPanel Spacing="8">
                      <ItemsControl ItemsSource="{Binding SecondaryHotkeys}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate>
                            <Grid ColumnDefinitions="*,Auto" Margin="0,4">
                              <StackPanel Grid.Column="0">
                                <TextBlock Text="{Binding Name}" FontWeight="Medium"/>
                                <TextBlock Text="{Binding Description}" FontSize="12" Opacity="0.7"/>
                              </StackPanel>
                              <Border Grid.Column="1"
                                      Background="{DynamicResource ControlBackgroundBrush}"
                                      CornerRadius="4"
                                      Padding="8,4">
                                <TextBlock Text="{Binding Hotkey}"
                                           FontFamily="{StaticResource MonospaceFontFamily}"/>
                              </Border>
                            </Grid>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </StackPanel>
                  </Expander>

                  <Button Content="Test Hotkey"
                          Command="{Binding TestHotkeyCommand}"
                          HorizontalAlignment="Left"/>
                </StackPanel>
              </DataTemplate>

              <!-- Upload Step -->
              <DataTemplate DataType="steps:UploadStepViewModel">
                <StackPanel Spacing="16">
                  <TextBlock Text="Choose your upload destination:"
                             FontWeight="Medium"/>

                  <ItemsControl ItemsSource="{Binding AvailableUploaders}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <RadioButton GroupName="UploaderSelection"
                                     IsChecked="{Binding $parent[ItemsControl].((steps:UploadStepViewModel)DataContext).SelectedUploaderId, Converter={StaticResource StringEqualsConverter}, ConverterParameter={Binding Id}}"
                                     Margin="0,4">
                          <Grid ColumnDefinitions="Auto,*" Margin="8,4">
                            <TextBlock Grid.Column="0" Text="{Binding Icon}" FontSize="20" Margin="0,0,12,0"/>
                            <StackPanel Grid.Column="1">
                              <TextBlock Text="{Binding Name}" FontWeight="Medium"/>
                              <TextBlock Text="{Binding Description}" FontSize="12" Opacity="0.7"/>
                            </StackPanel>
                          </Grid>
                        </RadioButton>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>

                  <!-- ShareX Import -->
                  <Button Content="Import from ShareX..."
                          Command="{Binding ImportFromShareXCommand}"
                          IsVisible="{Binding HasShareXConfig}"
                          HorizontalAlignment="Left"
                          Margin="0,8,0,0"/>

                  <!-- Test Result -->
                  <Border Background="{DynamicResource SuccessBrush}"
                          Opacity="0.1"
                          CornerRadius="4"
                          Padding="12"
                          IsVisible="{Binding TestResult, Converter={StaticResource StringNotEmptyConverter}}">
                    <TextBlock Text="{Binding TestResult}"
                               Foreground="{Binding IsTestSuccessful, Converter={StaticResource BoolToSuccessErrorBrushConverter}}"
                               TextWrapping="Wrap"/>
                  </Border>

                  <Button Content="Test Connection"
                          Command="{Binding TestConnectionCommand}"
                          IsEnabled="{Binding IsTestingConnection, Converter={StaticResource InverseBoolConverter}}"
                          HorizontalAlignment="Left">
                    <Button.Content>
                      <StackPanel Orientation="Horizontal" Spacing="8">
                        <ProgressBar IsIndeterminate="True"
                                     IsVisible="{Binding IsTestingConnection}"
                                     Width="16" Height="16"/>
                        <TextBlock Text="{Binding IsTestingConnection, Converter={StaticResource BoolToStringConverter}, ConverterParameter='Testing...|Test Connection'}"/>
                      </StackPanel>
                    </Button.Content>
                  </Button>
                </StackPanel>
              </DataTemplate>

              <!-- OCR Step -->
              <DataTemplate DataType="steps:OcrStepViewModel">
                <StackPanel Spacing="16">
                  <TextBlock Text="Select languages for text recognition:"
                             FontWeight="Medium"/>

                  <!-- Language Grid -->
                  <ItemsControl ItemsSource="{Binding AvailableLanguages}">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <WrapPanel/>
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <ToggleButton Content="{Binding DisplayName}"
                                      IsChecked="{Binding $parent[ItemsControl].((steps:OcrStepViewModel)DataContext).SelectedLanguages, Converter={StaticResource ListContainsConverter}, ConverterParameter={Binding LanguageTag}}"
                                      Command="{Binding $parent[ItemsControl].((steps:OcrStepViewModel)DataContext).ToggleLanguageCommand}"
                                      CommandParameter="{Binding LanguageTag}"
                                      Margin="4"
                                      Padding="8,4"/>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>

                  <!-- Size Warning -->
                  <Border Background="{DynamicResource WarningBrush}"
                          Opacity="0.1"
                          CornerRadius="4"
                          Padding="12"
                          IsVisible="{Binding ExceedsRecommendedSize}">
                    <TextBlock Text="{Binding TotalDownloadSizeMb, StringFormat='Selected languages will require approximately {0} MB of downloads.'}"
                               Foreground="{DynamicResource WarningBrush}"
                               TextWrapping="Wrap"/>
                  </Border>

                  <CheckBox Content="Download language data in the background"
                            IsChecked="{Binding DownloadInBackground}"/>
                </StackPanel>
              </DataTemplate>

              <!-- Complete Step -->
              <DataTemplate DataType="steps:CompleteStepViewModel">
                <StackPanel Spacing="16">
                  <TextBlock Text="You're all set up!"
                             FontSize="18"
                             FontWeight="SemiBold"/>

                  <TextBlock Text="{Binding SummaryText}"
                             TextWrapping="Wrap"/>

                  <CheckBox Content="Show tips on startup"
                            IsChecked="{Binding ShowTipsOnStartup}"/>

                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Content="Take First Screenshot"
                            Command="{Binding TakeFirstScreenshotCommand}"/>
                    <Button Content="Open Settings"
                            Command="{Binding OpenSettingsCommand}"/>
                  </StackPanel>
                </StackPanel>
              </DataTemplate>
            </ContentControl.DataTemplates>
          </ContentControl>
        </StackPanel>
      </ScrollViewer>
    </Border>

    <!-- Skip This Step Link -->
    <Button Grid.Row="3"
            Content="Skip this step →"
            Command="{Binding SkipCommand}"
            IsVisible="{Binding CurrentStep.CanSkip}"
            HorizontalAlignment="Left"
            Background="Transparent"
            BorderThickness="0"
            Padding="0"
            Margin="0,0,0,8"/>

    <!-- Footer Buttons -->
    <Grid Grid.Row="4" ColumnDefinitions="Auto,*,Auto,Auto">
      <Button Grid.Column="0"
              Content="← Back"
              Command="{Binding BackCommand}"
              IsVisible="{Binding CanGoBack}"/>

      <Button Grid.Column="2"
              Content="Skip All"
              Command="{Binding SkipAllCommand}"
              IsVisible="{Binding CanSkipAll}"
              Margin="0,0,8,0"/>

      <Button Grid.Column="3"
              Content="{Binding NextButtonText}"
              Command="{Binding NextCommand}"
              IsEnabled="{Binding CurrentStep.IsValid}"/>
    </Grid>

  </Grid>

</Window>
