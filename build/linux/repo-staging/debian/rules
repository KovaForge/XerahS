#!/usr/bin/make -f
# PPA-facing rules. Installs the official GitHub linux tarball into
# /usr/lib/xerahs, matching CreateDeb / the AUR PKGBUILD.

export DH_VERBOSE = 1

VERSION := @VERSION@
DEB_HOST_ARCH ?= $(shell dpkg-architecture -qDEB_HOST_ARCH)
ifeq ($(DEB_HOST_ARCH),arm64)
TARBALL_ARCH := linux-arm64
else
TARBALL_ARCH := linux-x64
endif

TARBALL := XerahS-$(VERSION)-$(TARBALL_ARCH).tar.gz

%:
	dh $@

override_dh_auto_configure:
	@test -f "$(TARBALL)" || { echo "missing $(TARBALL); copy the GitHub release asset next to debian/" >&2; exit 1; }

override_dh_auto_build:
	@true

override_dh_auto_install:
	mkdir -p debian/xerahs/usr/lib/xerahs
	tar -xzf "$(TARBALL)" -C debian/xerahs/usr/lib/xerahs
	mkdir -p debian/xerahs/usr/bin
	ln -sf ../lib/xerahs/XerahS debian/xerahs/usr/bin/xerahs
	chmod 755 debian/xerahs/usr/lib/xerahs/XerahS || true
	if [ -f debian/xerahs/usr/lib/xerahs/xerahs-watchfolder-daemon ]; then \
	  chmod 755 debian/xerahs/usr/lib/xerahs/xerahs-watchfolder-daemon; \
	fi
	mkdir -p debian/xerahs/usr/share/applications
	install -m 644 debian/xerahs.desktop debian/xerahs/usr/share/applications/xerahs.desktop
	mkdir -p debian/xerahs/usr/share/pixmaps
	if [ -f debian/xerahs/usr/lib/xerahs/Logo.png ]; then \
	  cp debian/xerahs/usr/lib/xerahs/Logo.png debian/xerahs/usr/share/pixmaps/xerahs.png; \
	fi

override_dh_strip:
	@true

override_dh_dwz:
	@true

override_dh_shlibdeps:
	@true
