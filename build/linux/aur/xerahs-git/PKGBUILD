#!/usr/bin/env bash

pkgname=xerahs-git
pkgver=0.20.13.r2437.ge4e407ea
pkgrel=1
pkgdesc='Cross-platform screen capture and sharing tool'
arch=('x86_64')
url='https://github.com/ShareX/XerahS'
license=('GPL3')
provides=('xerahs')
conflicts=('xerahs')
depends=('glibc' 'gcc-libs' 'hicolor-icon-theme')
optdepends=(
    'gnome-shell-extension-appindicator: system tray icon on GNOME'
    'webkit2gtk-4.1: video editor webview support'
    'wl-clipboard: Wayland clipboard support'
    'xclip: X11 clipboard support'
    'xdotool: X11 window management'
    'grim: Wayland screenshot utility'
    'slurp: Wayland region selection for screenshots'
)
makedepends=('git' 'dotnet-sdk')
options=('!strip' '!debug')

_xerahs_repo_root="${XERAHS_REPO_ROOT:?Set XERAHS_REPO_ROOT to the repository root before running makepkg.}"
source=("git+file://${_xerahs_repo_root}")
sha256sums=('SKIP')

pkgver() {
    cd "$srcdir/xerahs"

    local base_version
    local revision_count
    local short_hash

    base_version=$(sed -n 's:.*<Version>\(.*\)</Version>.*:\1:p' Directory.Build.props | head -n 1)
    revision_count=$(git rev-list --count HEAD)
    short_hash=$(git rev-parse --short HEAD)

    printf '%s.r%s.g%s\n' "$base_version" "$revision_count" "$short_hash"
}

prepare() {
    cd "$srcdir/xerahs"

    # This PKGBUILD builds from a local fork via XERAHS_REPO_ROOT. Submodules
    # may have fork-only commits that aren't pushed to the upstream submodule
    # remote URL, so `git submodule update --init --recursive` against the
    # recorded .gitmodules URLs would fail with "not our ref". The parent
    # working tree already has the submodules cloned at the recorded commits,
    # so redirect each submodule URL to that local clone. Falls back to the
    # upstream URL when the local clone isn't present (or doesn't contain the
    # recorded commit), keeping the PKGBUILD usable for non-local sources.
    while IFS= read -r name; do
        local path recorded_sha
        path=$(git config --file .gitmodules "submodule.$name.path")
        recorded_sha=$(git ls-tree HEAD -- "$path" | awk '{print $3}' | head -n1)
        if [ -n "$path" ] && [ -d "$_xerahs_repo_root/$path" ] \
                && [ -n "$recorded_sha" ] \
                && git -C "$_xerahs_repo_root/$path" cat-file -e "$recorded_sha" >/dev/null 2>&1; then
            git config --file .gitmodules "submodule.$name.url" "$_xerahs_repo_root/$path"
        fi
    done < <(git config --file .gitmodules --get-regexp 'submodule\..*\.path' \
            | awk '{print $1}' | sed -E 's/^submodule\.(.+)\.path$/\1/')
    git submodule sync --recursive

    # git >=2.38 disables the file:// transport for submodule clones by default
    # (CVE-2022-39253). The redirected URLs above are local file paths so we
    # must opt back in for this build context.
    git -c protocol.file.allow=always submodule update --init --recursive
}

build() {
    cd "$srcdir/xerahs"

    export XERAHS_ARCHITECTURES='linux-x64'
    export XERAHS_PLUGIN_JOBS="${XERAHS_PLUGIN_JOBS:-4}"

    # The packaging step exits non-zero when optional formats (AppImage, RPM)
    # can't be produced because their host toolchain isn't installed
    # (mksquashfs, rpmbuild). We only need the portable tarball and .deb for
    # this PKGBUILD's package() step, so don't let those optional failures
    # abort the build — but DO fail if the tarball itself wasn't produced.
    local app_version
    app_version=$(sed -n 's:.*<Version>\(.*\)</Version>.*:\1:p' Directory.Build.props | head -n1 | tr -d ' ')

    ./build/linux/package-linux.sh || {
        local rc=$?
        if [ -f "dist/XerahS-${app_version}-linux-x64.tar.gz" ]; then
            echo "==> build: package-linux.sh failed (rc=$rc) but portable tarball was produced; continuing"
            return 0
        fi
        echo "==> build: package-linux.sh failed and no portable tarball was produced"
        return $rc
    }
}

package() {
    cd "$srcdir/xerahs"

    local app_version
    local publish_tarball

    app_version=$(sed -n 's:.*<Version>\(.*\)</Version>.*:\1:p' Directory.Build.props | head -n 1)
    publish_tarball="$srcdir/xerahs/dist/XerahS-${app_version}-linux-x64.tar.gz"

    install -d "$pkgdir/usr/lib/xerahs"
    bsdtar -xf "$publish_tarball" -C "$pkgdir/usr/lib/xerahs"

    if [[ -f "$pkgdir/usr/lib/xerahs/XerahS" ]]; then
        chmod 755 "$pkgdir/usr/lib/xerahs/XerahS"
    fi

    if [[ -f "$pkgdir/usr/lib/xerahs/xerahs-watchfolder-daemon" ]]; then
        chmod 755 "$pkgdir/usr/lib/xerahs/xerahs-watchfolder-daemon"
    fi

    if [[ -f "$pkgdir/usr/lib/xerahs/omaxerahs" ]]; then
        chmod 755 "$pkgdir/usr/lib/xerahs/omaxerahs"
    fi

    install -d "$pkgdir/usr/bin"
    ln -s ../lib/xerahs/XerahS "$pkgdir/usr/bin/xerahs"
    ln -s ../lib/xerahs/omaxerahs "$pkgdir/usr/bin/omaxerahs"

    install -Dm644 LICENSE.txt "$pkgdir/usr/share/licenses/$pkgname/LICENSE.txt"

    install -Dm644 /dev/stdin "$pkgdir/usr/share/applications/xerahs.desktop" <<'DESKTOP'
[Desktop Entry]
Name=XerahS
Comment=Cross-platform screen capture and sharing tool
GenericName=Screen Capture
Exec=/usr/bin/xerahs %U
Icon=xerahs
Terminal=false
Type=Application
MimeType=x-scheme-handler/xerahs;
Categories=Utility;Graphics;GTK;
Keywords=screenshot;screen;capture;share;upload;
StartupWMClass=xerahs
X-GNOME-UsesNotifications=true
X-KDE-DBUS-Restricted-Interfaces=org.kde.KWin.ScreenShot2
DESKTOP

    install -Dm644 "$srcdir/xerahs/src/desktop/app/XerahS.UI/Assets/Logo.png" \
        "$pkgdir/usr/share/icons/hicolor/256x256/apps/xerahs.png"
}
